// ============================================================================
// GPU BACKEND DISPATCH INTERFACE
// ============================================================================

class IGpuBackendDispatch {
public:
    virtual ~IGpuBackendDispatch() = default;
    
    // Lifecycle
    virtual bool init() = 0;
    virtual void shutdown() = 0;
    
    // Hardware Detection
    virtual bool detectHardware() = 0;
    virtual HardwareProfile getHardwareProfile() const = 0;
    
    // Pipeline Stages
    virtual bool initializeStage0() = 0;  // Init & Hardware Profile
    virtual bool initializeStage1() = 0;  // Asset Loading
    virtual bool initializeStage2() = 0;  // Temporal Analysis
    virtual bool initializeStage3() = 0;  // Shutter Sampling
    virtual bool initializeStage4() = 0;  // Interpolation
    virtual bool initializeStage5() = 0;  // Noise Sync
    virtual bool initializeStage6() = 0;  // V-Sync Injector
    virtual bool initializeStage7() = 0;  // LuxRays Swap
    virtual bool initializeStage8() = 0;  // Matrix Reconstruction
    virtual bool initializeStage9() = 0;  // GPU Render Pipeline
    virtual bool initializeStage10() = 0; // Post-Processing
    virtual bool initializeStage11() = 0; // Analytics
    
    // Core Operations
    virtual bool processFrame(void* frame_data, int width, int height) = 0;
    virtual bool renderFrame(void* framebuffer, int width, int height) = 0;
    virtual bool applyUpscaling(int target_width, int target_height) = 0;
    
    // Configuration
    virtual void configure(int stage, const void* config) = 0;
    virtual void* getConfig(int stage) const = 0;
    
    // Query
    virtual bool isInitialized() const = 0;
    virtual int getStageStatus(int stage) const = 0;
    virtual std::string getLastError() const = 0;
    
    // Plugin Management
    virtual bool loadPlugin(const std::string& plugin_path) = 0;
    virtual bool unloadPlugin(const std::string& plugin_name) = 0;
    
protected:
    IGpuBackendDispatch();
    virtual ~IGpuBackendDispatch();
};

