class ShaderCompiler {
private:
    std::unordered_map<std::string, std::vector<char>> compiledShaders_;   // Cache results
    
public:
    bool compileDirect(const fspath& shaderPath, const std::string& outputPath) {
        auto result = compileShader(shaderPath);
        
        if (result.second) {
            Store in cache for future compilations
            compiledShaders_[outputPath] = stdmove(result.first);
            
            return true;   // Cache hit - skip compilation
        } else {
            throw std::runtime_error("Shader compilation failed");
        }
    }

private:
    bool compileShader(const fspath& shaderPath) {
        auto nvccArgs = nvcc -Xcompiler=D'DIRECTX12' ;
        std::string command = nvccArgs + shaderPath.string() +  -o  + outputPath;
        
        system(command.c_str());
        return true;   // Assume success for now
    }

private:
    std::unordered_map<std::string, std::vector<char>> compiledShaders_;
};

