            float diff = std::abs(cpuFrame[gridA_[i].y * width_ + 
                gridA_[i].x] - gpuFrame[gridB_[i].y * width_ + 
                gridB_[i].x]);

            if (diff < 0.05f) { // Adaptive threshold
                signatureCache_[sigA] = true;
                gridA_[i].validated = true;
                gridB_[i].validated = true;
            } else {
                gridA_[i].validated = false;
                gridB_[i].validated = false;
            }
        }
    }

private:
    int width_, height_, blockSize_;
    std::vector<Block> gridA_;
    std::vector<Block> gridB_;
    std::unordered_map<uint64_t, bool> signatureCache_;
};

