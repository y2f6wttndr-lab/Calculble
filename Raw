#include <functional>

class MemoryPool {
private:
    std::vector<std::unique_ptr<float[]>> bufferPool_;
    size_t totalCapacity_;
    
public:
    explicit MemoryPool(size_t capacity) : totalCapacity_(capacity) {}
    
    void expandMemory(size_t newCapacity) {
        if (newCapacity == 0) return;
        
        auto oldSize = bufferPool_.size();
        bufferPool_.resize(newCapacity);
        
        for (auto& ptr : bufferPool_) {
            if (!ptr->empty()) {
                std::unique_ptr<float[]> newPtr = std::make_unique<float[]>(newCapacity - ptr->size());
                newPtr->assign(ptr.get(), ptr->data() + ptr->size());
                *ptr = std::move(newPtr);
            }
        }
