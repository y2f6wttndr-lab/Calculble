class MemoryPool {
private:
    std::vector<std::unique_ptr<float[]>> bufferPool_;   // Current implementation
    size_t totalCapacity_;
    
public:
    explicit MemoryPool(size_t initialCapacity = 1024) 
        : totalCapacity_(initialCapacity), m_capacity(0) {}

    void expandMemory(size_t newCapacity) {
        if (newCapacity <= m_capacity_) return;
        
        auto oldSize = m_capacity_;
        m_capacity_ = newCapacity;
        
        // Resize buffer pool with pre-allocation
        for (auto& ptr : bufferPool_) {
            if (!ptr->empty()) {
                ptr->shrink_to_fit();   Release unused memory
            }
        }
    }

    void preAllocateFrameBuffers(const std::vector<float>& rawFlux, 
                                  const EngineConfig& config) {
        auto fluxBuffer = std::make_unique<std::vector<float>>(rawFlux.size() * 2);
        
        // Pre-allocate with minimal overhead
        bufferPool_.push_back(std::move(fluxBuffer));
    }

    void popOutput() {
        if (bufferPool_.empty()) return;
        auto f = bufferPool_.back().get();
        bufferPool_.pop_back();   Remove from pool, not just vector
        return f;
    }

private:
    size_t m_capacity = 0;
};

