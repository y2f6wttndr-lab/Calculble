        DopplerEffect doppler(targetX, targetY, velocityZ);
        doppler.applyToGrids(pipeline.gridA_, pipeline.gridB_);

        // Synthesize output using validated blocks + temporal history
        std::vector<float> output(WIDTH * HEIGHT);
        
        for (int y = 0; y < HEIGHT; ++y) {
            for (int x = 0; x < WIDTH; ++x) {
                int idx = y * WIDTH + x;

                // Get temporal history around current frame
                auto history = temporal.getHistory(
                    output[idx], output[idx] + 0.1f, 0.2f);

                if (!history.empty()) {
                    for (const auto& h : history) {
                        int idx2 = h.first * WIDTH + x;
                        if (idx2 < output.size()) {
                            output[idx] += h.second;
                        }
                    }
                }
            }
        }

        // Write validated blocks to output
        for (int y = 0; y < HEIGHT; ++y) {
            for (int x = 0; x < WIDTH; ++x) {
                int idx = y * WIDTH + x;
                
                if (corePipeline.gridA_[idx].validated || 
                    corePipeline.gridB_[idx].validated) {
                    output[idx] += gpuFrame[gridB_[idx].y * width_ + gridB_[idx].x];
                } else {
                    output[idx] *= 0.5f; // Blend with average
                }
            }
        }

        frameCount.fetch_add(1);  // ✅ FIXED: Proper atomic increment
    }

