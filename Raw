    void setupGrids() {
        if (width_ <= 0 || height_ <= 0 || blockSize_ <= 1) return;

        int cols = width_ / blockSize_;
        int rows = height_ / blockSize_;
        
        for (int y = 0; y < rows; ++y) {
            for (int x = 0; x < cols; ++x) {
                Block a{ x * blockSize_, y * blockSize_, blockSize_ };
                // Mirror on X axis
                Block b{ (cols - 1 - x) * blockSize_, y * blockSize_, blockSize_ };
                
                gridA_.push_back(a);
                gridB_.push_back(b);
            }
        }
    }

    void processFrame(const std::vector<float>& cpuFrame, 
                     const std::vector<float>& gpuFrame) {
        IntentDetector detector;
        
        for (size_t i = 0; i < gridA_.size(); ++i) {
            uint64_t sigA = detector.computeSignature(cpuFrame + 
                gridA_[i].y * width_ + gridA_[i].x);
            uint64_t sigB = detector.computeSignature(gpuFrame + 
                gridB_[i].y * width_ + gridB_[i].x);

            // LEGO EFFECT: Instant validation if cached
            if (signatureCache_.count(sigA)) {
                gridA_[i].validated = true;
                gridB_[i].validated = true;
