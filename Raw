class DopplerEffect {
public:
    void setTarget(float tx, float ty, float vz) {
        if (tx < 0 || tx > 1.0f || ty < 0 || ty > 1.0f || vz < 0) {
            targetX_ = 0.5f; targetY_ = 0.3f; velocityZ_ = 1.2f; // Default values
        } else {
            targetX_ = tx; targetY_ = ty; velocityZ_ = vz;
        }
    }

    static void applyToGrids(std::vector<Block>& gridA, std::vector<Block>& gridB) {
        for (size_t i = 0; i < gridA_.size(); ++i) {
            float dx = gridA_[i].x - targetX_;
            float dy = gridA_[i].y - targetY_;
            float distance = std::sqrt(dx * dx + dy * dy);

            // Doppler attraction: stronger when closer to motion vector
            float dopplerShift = gain_ / (1.0f + distance * 0.02f) 
                               * (1.0f + velocityZ);

            gridA_[i].priority = dopplerShift;
            gridB_[i].priority = dopplerShift; // Mirror symmetry
        }
    }

private:
    float targetX_, targetY_;
    float velocityZ_;
    
    static constexpr float GAIN_DEFAULT = 2.0f;
    static constexpr float FALLOFF_DEFAULT = 0.95f;

    void setDefaultParams() {
        gain_ = GAIN_DEFAULT;
        falloff_ = FALLOFF_DEFAULT;
    }
};

class AdaptiveThresholdValidator {
public:
    void setPriority(float p) { m_priority = p; }

    static void validate(const std::vector<float>& cpuFrame, 
                         const std::vector<float>& gpuFrame) {
        if (cpuFrame.size() < gridA_.size() || gpuFrame.size() < gridB_.size()) {
            return; // Not enough data for validation
        }

        for (size_t i = 0; i < gridA_.size(); ++i) {
            float valA = cpuFrame[gridA_[i].y * width_ + 
                gridA_[i].x];
            float valB = gpuFrame[gridB_[i].y * width_ + 
                gridB_[i].x];

            // Adaptive threshold: lower for high-priority (motion-detectable) areas
            float diff = std::abs(valA - valB);
            float threshold = 0.05f * m_priority;

            if (diff < threshold) {
                gridA_[i].validated = true;
                gridB_[i].validated = true;
            } else {
                gridA_[i].validated = false;
                gridB_[i].validated = false;
            }
        }
    }

private:
    int width_;
    std::vector<Block> gridA_;
    std::vector<Block> gridB_;
};

class SignatureCache {
public:
    // Precompute signatures for all block sizes to avoid recomputing
    static void precomputeSignatures(int bs, std::vector<std::vector<uint64_t>>& cache) {
        if (cache.empty()) return;

        for (int s = 0; s < bs; ++s) {
            cache[s].resize(bs * bs);
            for (int y = 0; y < bs; ++y) {
                for (int x = 0; x < bs; ++x) {
                    int idx = y * width_ + x;
                    uint64_t sum = 0.0f;
                    for (int dy = 0; dy < s; ++dy) {
                        for (int dx = 0; dx < s; ++dx) {
                            sum += frame[(y + dy) * width_ + (x + dx)];
                        }
                    }
                    cache[s][s] = static_cast<uint64_t>(sum * 1000) % 997;
                }
            }
        }
    }

    // Compute signature using precomputed values for O(1) lookup
    static uint64_t computeSignature(const std::vector<float>& frame, 
                                     int x, int y, int size) const {
        if (signatureCache_.count(precomputeSignatures(size).back().data())) {
            return signatureCache_[precomputeSignatures(size).back().data()];
        }

        float sum = 0.0f;
        for (int dy = 0; dy < size && (y + dy) * width_ < frame.size(); ++dy) {
            for (int dx = 0; dx < size && (x + dx) * width_ < frame.size(); ++dx) {
                sum += frame[(y + dy) * width_ + (x + dx)];
            }
        }

        return static_cast<uint64_t>(sum * 1000) % 997;
    }

private:
    int width_;
    std::vector<std::vector<uint64_t>> precomputedSignatures[32]; // Cache for common block sizes
};

