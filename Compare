            if (FAILED(hr)) {
                std::cerr << "Failed to create DXGI adapter: " << FormatMessageW(
                    FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM,
                    nullptr, 0, MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT),
                    nullptr, nullptr, nullptr) << std::endl;
                return;
            }

            IDXGIDevice* pDevice = nullptr;
            hr = IDXGIDevice::CreateDXGIDevice(
                IID_IDXGIDevice, 
                reinterpret_cast<void**>(pDevice), 
                0);

            if (FAILED(hr)) {
                std::cerr << "Failed to create DXGI device: " << FormatMessageW(
                    FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM,
                    nullptr, 0, MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT),
                    nullptr, nullptr, nullptr) << std::endl;
                return;
            }

            IDXGIBuffer* pWriteBuffer = nullptr;
            hr = IDXGIBuffer::CreateDXGIBuffer(
                IID_IDXGIBuffer, 
                reinterpret_cast<void**>(pWriteBuffer), 
                width * height, 
                DXGI_FORMAT_R8G8B8A8_UNORM, 
                0);

            if (FAILED(hr)) {
                std::cerr << "Failed to create DX12 buffer: " << FormatMessageW(
                    FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM,
                    nullptr, 0, MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT),
                    nullptr, nullptr, nullptr) << std::endl;
                return;
            }

            hr = IDXGIBuffer::CopyToBuffer(
                pWriteBuffer, 
                width * height, 
                frame.data(), 
                width * sizeof(float));

            if (FAILED(hr)) {
                std::cerr << "Failed to copy DX12 buffer: " << FormatMessageW(
                    FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM,
                    nullptr, 0, MAKELANGID(LANG_NEUTRAL, SUBLANG_DEFAULT),
                    nullptr, nullptr, nullptr) << std::endl;
                return;
            }

            IDXGIBuffer::Release(pWriteBuffer);
            IDXGIAdapter::Release(pAdapter);
            IDXGIDevice::Release(pDevice);
            IDXGIFactory1::Release(pFactory);

        } catch (...) {
            std::cerr << "DX12 writeFrame failed: " << std::current_exception()->what() << "\n";
        }
    }

private:
    static void readPixel(int x, int y) { return 0.0f; }
    static void writePixel(int x, int y, float value) {}
};

class OpenGLMemoryAccessors {
public:
    // Read frame from CPU to OpenGL texture (for rendering)
    static std::vector<float> readFrameOpenGL(int width, int height) {
        if (width <= 0 || height <= 0) return {};

        try {
            GLuint tex = createTexture(width, height);
            
            if (tex == 0) {
                std::cerr << "Failed to create OpenGL texture: GL_ERROR" << std::endl;
                glDeleteTextures(1, &tex);
                return {};
            }

            glBindTexture(GL_TEXTURE_2D, tex);
            glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, width, height, 0, 
                         GL_RGB, GL_UNSIGNED_BYTE, nullptr);

            std::vector<float> frame(width * height);
            
            for (int y = 0; y < height; ++y) {
                for (int x = 0; x < width; ++x) {
                    float* texData = reinterpret_cast<float*>(glGetTexImage(
                        GL_TEXTURE_2D, 0, GL_RGB, nullptr, nullptr));
                    frame[y * width + x] = texData[x];
                }
            }

            glDeleteTextures(1, &tex);
            
            return frame;
        } catch (...) {
            std::cerr << "OpenGL readFrame failed: " << std::current_exception()->what() << "\n";
            return {};
        }
    }

    // Write frame from CPU to OpenGL texture (for rendering)
    static void writeFrameOpenGL(int width, int height, const std::vector<float>& frame) {
        if (width <= 0 || height <= 0) return;

        try {
            GLuint tex = createTexture(width, height);
            
            if (tex == 0) {
                std::cerr << "Failed to create OpenGL texture: GL_ERROR" << std::endl;
                glDeleteTextures(1, &tex);
                return;
            }

            glBindTexture(GL_TEXTURE_2D, tex);
            glTexImage2D(GL_TEXTURE_2D, 0, GL_R8, width, height, 0, 
                         GL_RGB, GL_UNSIGNED_BYTE, nullptr);

            for (int y = 0; y < height; ++y) {
                for (int x = 0; x < width; ++x) {
                    float* texData = reinterpret_cast<float*>(glGetTexImage(
                        GL_TEXTURE_2D, 0, GL_RGB, nullptr, nullptr));
                    texData[x] = frame[y * width + x];
                }
            }

            glDeleteTextures(1, &tex);
        } catch (...) {
            std::cerr << "OpenGL writeFrame failed: " << std::current_exception()->what() << "\n";
        }
    }

private:
    static GLuint createTexture(int width, int height) {
        GLuint tex;
        glGenTextures(1, &tex);
        
        if (tex == 0) {
            std::cerr << "Failed to create OpenGL texture: GL_ERROR" << std::endl;
            return 0;
        }

        glBindTexture(GL_TEXTURE_2D, tex);
        
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_REPEAT);
        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_REPEAT);

        return tex;
    }

private:
    static void deleteTexture(GLuint& tex) {
        if (tex != 0) {
            glDeleteTextures(1, &tex);
        }
    }
};

