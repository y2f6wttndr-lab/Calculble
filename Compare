class ErrorHandler {
public:
    // Log error with severity level
    static void onError(const std::string& message, int severity = 0) {
        if (severity == 0) {
            std::cerr << "[WARN] " << message << "\n";
        } else if (severity == 1) {
            std::cerr << "[ERROR] " << message << "\n";
        } else if (severity == 2) {
            std::cerr << "[FATAL] " << message << "\n";
        }
    }

    // Log critical error with immediate cleanup
    static void onFatalError(const std::string& message, 
                             const EngineConfig& config) {
        std::cerr << "[CRITICAL] Fatal error: " << message << "\n";
        
        // Attempt graceful shutdown before termination
        try {
            shutdown(config);
        } catch (...) {
            // Continue with cleanup on exception
        }

        std::terminate();  // Or call abort() for Unix
    }

private:
    static constexpr int CRITICAL = 1;
    static constexpr int WARN = 0;
};

