class ConfigValidator {
public:
    // Valid engine modes with strict bounds checking
    enum class EngineMode {
        Passthru,      // No processing - direct output
        Smooth,         // Slight interpolation
        Benchmark,      // High precision analysis
        AutoTrain,      // Training mode
        Auto             // Automatic selection
    };

    // Valid performance states with strict bounds checking
    enum class PerfState {
        Idle,           // Normal operation
        Stable,         // Predictable behavior
        Boost,          // Performance optimization
        Protect,        // Safety mode
        Saturated       // Maximum capacity reached
    };

    // Valid gear values for block sizing
    enum class Gear {
        G8 = 8,
        G16 = 16,
        G24 = 24,
        G32 = 32,
        G64 = 64
    };

    // Valid buffer sizes with minimum/maximum constraints
    struct BufferConstraints {
        static constexpr int MIN_SIZE = 1024;
        static constexpr int MAX_SIZE = 8192 * 1024;  // 8MB max
    };

    // Validate engine mode
    static bool isValidMode(EngineMode mode) {
        switch (mode) {
            case EngineMode::Passthru: return true;
            case EngineMode::Smooth: return true;
            case EngineMode::Benchmark: return true;
            case EngineMode::AutoTrain: return true;
            case EngineMode::Auto: return true;
        }
        throw std::invalid_argument("Invalid engine mode");
    }

    // Validate performance state
    static bool isValidPerfState(PerfState state) {
        switch (state) {
            case PerfState::Idle: return true;
            case PerfState::Stable: return true;
            case PerfState::Boost: return true;
            case PerfState::Protect: return true;
            case PerfState::Saturated: return true;
        }
        throw std::invalid_argument("Invalid perf state");
    }

    // Validate gear value
    static bool isValidGear(Gear gear) {
        switch (gear) {
            case Gear::G8: return true;
            case Gear::G16: return true;
            case Gear::G24: return true;
            case Gear::G32: return true;
            case Gear::G64: return true;
        }
        throw std::invalid_argument("Invalid gear value");
    }

    // Validate buffer size
    static bool isValidBufferSize(std::size_t size) {
        if (size <= 0 || size > BufferConstraints::MAX_SIZE) {
            throw std::invalid_argument(
                "Buffer size must be between 1 and " + 
                std::to_string(BufferConstraints::MAX_SIZE));
        }
        return true;
    }

    // Validate threshold values (0.0 to 1.0 range)
    static bool isValidThreshold(float t, float minT = 0.0f, float maxT = 1.0f) {
        if (t < minT || t > maxT) {
            throw std::invalid_argument(
                "Threshold must be between " + 
                std::to_string(minT) + " and " + std::to_string(maxT));
        }
        return true;
    }

    // Validate entire configuration structure
    static bool validateConfig(const EngineConfig& config, 
                               const EngineMode mode) {
        try {
            // Mode validation
            if (!isValidMode(mode)) throw std::invalid_argument("Invalid engine mode");

            // Buffer size validation for all buffers
            for (auto& buf : config.buffers) {
                if (!isValidBufferSize(buf.size)) throw std::invalid_argument(
                    "Buffer size must be positive and within bounds");
                
                if (buf.capacity < 1024 || buf.capacity > 65536 * 1024) {
                    throw std::invalid_argument(
                        "Buffer capacity must be between 1KB and 64MB");
                }
            }

            // Threshold validation for all thresholds
            for (auto& threshold : config.thresholds) {
                if (!isValidThreshold(threshold.value, 
                                   threshold.min, threshold.max)) {
                    throw std::invalid_argument(
                        "Threshold must be between min and max");
                }
            }

            // Block size validation
            for (auto& block : config.blocks) {
                if (block.size < 16 || block.size > 4096) {
                    throw std::invalid_argument(
                        "Block size must be between 16 and 4096");
                }
            }

            return true;
        } catch (...) {
            return false;
        }
    }

private:
    static constexpr float MIN_THRESHOLD = 0.0f;
    static constexpr float MAX_THRESHOLD = 1.0f;
};

