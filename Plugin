// ============================================================================
// STAGE 1: FRAME PROCESSING PLUGIN INTERFACE
// ============================================================================

struct FrameProcessingConfig {
    int quality_level;
    bool enable_compression;
    int compression_quality;
    bool enable_motion_analysis;
    bool enable_temporal_filtering;
};

class IFrameProcessingPlugin : public IPlugin {
public:
    virtual ~IFrameProcessingPlugin() = default;
    
    // Frame Processing
    virtual bool processFrame(void* frame_data, int width, int height) = 0;
    virtual bool processBatch(void* frames[], int frame_count, int width, int height) = 0;
    
    // Motion Analysis
    virtual bool analyzeMotion(void* frame_data, int width, int height) = 0;
    virtual float getMotionIntensity() const = 0;
    virtual float getMotionVector(const int x, const int y) const = 0;
    
    // Temporal Filtering
    virtual bool applyTemporalFilter(void* frame_data, int width, int height) = 0;
    virtual float getCoherenceScore() const = 0;
    virtual float getVariationMean() const = 0;
    
    // Compression
    virtual bool compressFrame(void* frame_data, void** compressed, size_t* compressed_size) = 0;
    virtual bool decompressFrame(void* compressed, void** decompressed, size_t* decompressed_size) = 0;
    
    // Query
    virtual int getProcessedFrameCount() const = 0;
    virtual int getCompressionRatio() const = 0;
    
protected:
    IFrameProcessingPlugin();
    virtual ~IFrameProcessingPlugin();
};

// ============================================================================
// STAGE 2: GRAPHICS PIPELINE PLUGIN INTERFACE
// ============================================================================

struct GraphicsPipelineConfig {
    int render_target_width;
    int render_target_height;
    int color_bits;
    int depth_bits;
    bool enable_vsync;
    int vsync_mode;
    bool enable_gbuffer;
    int gbuffer_depth;
    bool enable_antialiasing;
    int antialiasing_method;
    bool enable_post_processing;
    int post_processing_quality;
    bool enable_shadows;
    bool enable_upscaling;
    int upscaling_quality;
    int filter_type;
    int rescale_quality;
    int output_format;
};

class IGraphicsPipelinePlugin : public IPlugin {
public:
    virtual ~IGraphicsPipelinePlugin() = default;
    
    // Lifecycle
    virtual bool init() = 0;
    virtual void shutdown() = 0;
    
    // Rendering
    virtual bool renderFrame(void* framebuffer, int width, int height) = 0;
    virtual bool renderToTexture(void* texture, int width, int height) = 0;
    virtual bool renderHalfFrame(void* mesh_data, int width, int height) = 0;
    
    // Buffer Management
    virtual bool allocateBuffer(void** buffer, int width, int height, int color_bits) = 0;
    virtual bool freeBuffer(void* buffer) = 0;
    virtual bool swapBuffers(void* front_buffer, void* back_buffer) = 0;
    
    // Anti-Aliasing
    virtual bool applyMultisample(void* framebuffer, int width, int height) = 0;
    virtual bool applyTAA(void* framebuffer, int width, int height) = 0;
    virtual bool applyFXAA(void* framebuffer, int width, int height) = 0;
    
    // Post-Processing
    virtual bool applyBloom(void* framebuffer, int width, int height) = 0;
    virtual bool applyTonemapping(void* framebuffer, int width, int height) = 0;
    virtual bool applySharpening(float* framebuffer, int width, int height) = 0;
    
    // Upscaling
    virtual bool applyUpscaling(void* framebuffer, int src_width, int src_height,
                               int dst_width, int dst_height) = 0;
    virtual bool applyDLSS(void* framebuffer, int width, int height) = 0;
    virtual bool applyFSR(void* framebuffer, int width, int height) = 0;
    
    // Query
    virtual bool isInitialized() const = 0;
    virtual GraphicsPipelineConfig getConfig() const = 0;
    virtual void setConfig(const GraphicsPipelineConfig& config) = 0;
    
protected:
    IGraphicsPipelinePlugin();
    virtual ~IGraphicsPipelinePlugin();
};

