    virtual IPlugin* getPlugin(const std::string& plugin_type) const = 0;
    virtual int getLoadedPluginCount() const = 0;
    virtual int getEnabledPluginCount() const = 0;
    
    // Configuration
    virtual bool setPluginConfig(const std::string& plugin_type, const void* config) = 0;
    virtual void* getPluginConfig(const std::string& plugin_type) const = 0;
    virtual bool validatePluginConfig(const std::string& plugin_type) = 0;
    
    // Hot-Reload
    virtual bool hotReloadPlugin(const std::string& plugin_type) = 0;
    virtual bool isPluginHotReloadable(const std::string& plugin_type) const = 0;
    
protected:
    IPluginManager();
    virtual ~IPluginManager();
};

