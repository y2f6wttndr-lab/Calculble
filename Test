            baseRequiredCalculations = 90; // Optimized default - CONTINUOUS
        }
        
        m.cpuCalculationsPerformed = cpuFilter_.processAndOptimizeBlocks(baseRequiredCalculations);
        applyAntiAliasingPrestidigitation(currentPhase, m);

        if (currentPhase.triggersVsyncDischarge) {
            if (currentPhase.duration == 24) {
                std::cout << " [Vsync Latch] T=24 : Liberation asynchrone de 20 frames stabilisees" << std::endl;
            } else if (currentPhase.duration == 48) {
                std::cout << " [Vsync Latch] T=48 : Purge et reconstruction complete" << std::endl;
            }
        }

        // ✅ GPU PAKING: Use memory pool for frame data - HIGH IMPACT!
        auto upscaled = std::make_unique<std::vector<float>>(fluxBuffer->size() * 2);
        
        PixelShaderEngine::executeSpatialUpscaleSIMD(*upscaled, 1.2f);
        
        buffer_.push(std::move(*upscaled), config_.maxFrameBufferQueue);
        
        m.bufferSize = buffer_.size();
        m.endToEndLatencyMs = static_cast<float>(nowMs() - t0);
        
        currentPhaseIdx_ = (currentPhaseIdx_ + 1) % phases_.size();
        lastMetrics_ = m;
    }

    // ✅ GPU PAKING: Memory-efficient frame pop - HIGH IMPACT!
    std::vector<float> popOutput() {
        auto f = buffer_.pop();
        if (!f.empty()) {
            memoryPool_.deallocate(f.data());  // Clean up after use - CONTINUOUS CLEANUP
        }
        return f;
    }
