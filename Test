      template <typename FrameData>
      class FPScaleEngine {
      public:
          FPScaleEngine(const VRTConfig& vrtCfg, const NoiseSyncConfig& noiseCfg)
              : vrt_(vrtCfg)
              , noise_(noiseCfg) {}
  
          void beginFrame() {
              vrt_.beginFrame();
          }
  
          // Un tick d'exécution linéaire synchronisant tout le pipeline
          PipelineState tick(float prev, float curr, float next, const FrameData& frame) {
              const TickInfo tInfo = clock_.next();
              
              // 1. Stabilisation GPU via NoiseSync
              const float noiseSample = noise_.nextSample();
              
              // 2. Analyse temporelle et asymétrie par l'IntentDetector
              const IntentMetrics metrics = IntentDetector::analyze(prev, curr, next);
              
              // 3. Injection et régulation dans le CircularBuffer temporel
              circular_.push(frame, metrics.asymmetryRatio);
              
              // 4. Copie vers le double-buffer de dispatch Motion Vectors / Doppler
              doubleBuffer_.updateData(frame);
  
              // 5. Gestion de la décharge physique sur latch de synchronisation V-Sync
              if (tInfo.isDischargeTick) {
                  std::vector<FrameData> dischargedFrames = circular_.discharge();
                  // Envoyer les données au Backend GPU via Zero-Copy ici
                  (void)dischargedFrames;
              }
  
              // 6. Fin de mesure et auto-training des itérations
              const std::size_t iterations = vrt_.endFrame();
  
              PipelineState state{};
              state.ticksProcessed = clock_.globalTick();
              state.lastNoiseStabilization = noiseSample;
              state.activeIterations = iterations;
              state.currentIntent = metrics;
  
              return state;
          }
  
      private:
          ChronoOrchestrator          clock_;
          VRTulator                   vrt_;
          NoiseSync                   noise_;
          CircularBuffer<FrameData>   circular_;
          SingleDoubleBuffer<FrameData> doubleBuffer_;
      };
  
