        // ------------------------------------------------------------
      struct TickInfo {
          uint32_t cycleIndex = 0;
          int16_t offset = 0;          // Décalage temporel horaire (+16) ou anti-horaire (-16)
          bool isResetTick = false;    // Remise à zéro à 24
          bool isDischargeTick = false; // Décharge du buffer (latch)
      };
  
      class ChronoOrchestrator {
      public:
          ChronoOrchestrator() : tick_(0) {}
  
          void reset() { tick_ = 0; }
  
          TickInfo next() {
              TickInfo info{};
              info.cycleIndex = tick_ % 152u;
  
              // Logique de cycle 16, 16, 24 (et 16, 16, 48)
              uint32_t phaseIndex = info.cycleIndex % 48u;
  
              if (phaseIndex < 16) {
                  // Premier segment : Décalage horaire (+16)
                  info.offset = 16;
              } else if (phaseIndex < 32) {
                  // Deuxième segment : Décalage anti-horaire (-16)
                  info.offset = -16;
              } else if (phaseIndex == 32) {
                  // Fin de phase de transition : Remise à zéro à 24
                  info.offset = 0;
                  info.isResetTick = true;
              }
  
              // Décharge de synchronisation du buffer à la transition 24 ou 48
              if (info.cycleIndex == 23 || info.cycleIndex == 47 || info.cycleIndex == 151) {
                  info.isDischargeTick = true;
              }
  
              ++tick_;
              return info;
          }
  
      private:
          uint32_t tick_;
      };
  
      // ------------------------------------------------------------
      // VRTulator : Auto-training et régulation de charge
      // ------------------------------------------------------------
      struct VRTConfig {
          double targetFrameTimeMs = 16.67; // 60 FPS cible
          double safetyMargin      = 0.20;  // 20% de marge de sécurité CPU
          std::size_t minIterations = 1;
          std::size_t maxIterations = 152; 
      };
  
      class VRTulator {
      public:
          explicit VRTulator(const VRTConfig& cfg = VRTConfig{})
              : cfg_(cfg)
              , currentIterations_(cfg.minIterations) {} 
  
          void beginFrame() {
              startTime_ = std::chrono::high_resolution_clock::now();
          }
  
          std::size_t endFrame() {
              auto endTime = std::chrono::high_resolution_clock::now();
              std::chrono::duration<double, std::milli> elapsed = endTime - startTime_;
              const double actualMs = elapsed.count();
              const double budgetMs = cfg_.targetFrameTimeMs * (1.0 - cfg_.safetyMargin);
  
              if (actualMs < budgetMs) {
                  const double ratio = budgetMs / (actualMs + 1e-6);
                  if (ratio > 1.1) {
                      currentIterations_ = std::min(cfg_.maxIterations, 
                          static_cast<std::size_t>(currentIterations_ * 1.1));
                  } else {
                      currentIterations_ = std::min(cfg_.maxIterations, currentIterations_ + 1);
                  }
              } else {
                  currentIterations_ = std::max(cfg_.minIterations, 
                      static_cast<std::size_t>(currentIterations_ * 0.7));
              }
              return currentIterations_;
          }
  
          std::size_t currentIterations() const { return currentIterations_; }
  
      private:
          VRTConfig cfg_;
          std::size_t currentIterations_;
          std::chrono::high_resolution_clock::time_point startTime_;
      };
  
