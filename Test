      constexpr double PI_CONST = 3.14159265358979323846;
      constexpr double PHI_GOLDEN = 1.6180339887498948482;
  
      // Helper Jitter basé sur Pi
      inline float PiJitter(unsigned int i, float scale = 1.0f) {
          float v = std::fmod(static_cast<float>(i * PI_CONST), 1.0f);
          return (v - 0.5f) * 2.0f * scale;
      }
  
      // Calcul du coefficient Lanczos (a=2) enrichi par le jitter sub-pixel
      inline float GetLanczosWeight(float x, float jitter, int a = 2) {
          float rx = std::fabs(x + jitter);
          if (rx < 1e-5f) return 1.0f;
          if (rx >= static_cast<float>(a)) return 0.0f;
          float piRx = rx * static_cast<float>(PI_CONST);
          return (std::sin(piRx) / piRx) * (std::sin(piRx / a) / (piRx / a));
      }
  
