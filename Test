              , m_frames_size(0) {}
  
          void pushFrame(const float* frame, double timestamp, float asymmetryRatio) {
              std::unique_lock<std::shared_mutex> lock(mutex_);
              
              // Cycles de décharge basés sur l'asymétrie (seuils de 24 ou 48 selon la pression temporelle)
              size_t maxHold = (asymmetryRatio > 1.0f) ? 48 : 24;
              
              if (m_frames.size() >= m_capacity || m_frames.size() >= maxHold) {
                  // Décharge du buffer temporel (Seagull double-buffer reset à 16)
                  size_t itemsToRemove = m_frames.size() - 16;
                  m_frames.erase(m_frames.begin(), m_frames.begin() + itemsToRemove);
              }
              
              m_frames.push_back({frame, timestamp});
              m_frames_size = m_frames.size();
          }
  
          const std::pair<const float*, double>& selectReferenceFrame(double target, float asymmetryRatio) const {
              std::shared_lock<std::shared_mutex> lock(mutex_);
              if (m_frames.empty()) {
                  static const std::pair<const float*, double> emptyResult{nullptr, 0.0};
                  return emptyResult;
              }
  
              // Recherche indexée par Pi pour cibler l'historique de décharge
              double offset = std::fabs(asymmetryRatio) * PI_CONST;
              auto it = std::find_if(m_frames.begin(), m_frames.end(), [target, offset](const auto& f) {
                  return std::abs(f.second - target) < (0.1f * offset);
              });
  
              if (it == m_frames.end()) {
                  return m_frames.back();
              }
              return *it;
          }
  
      private:
          size_t m_capacity;
          size_t m_frames_size;
          std::vector<std::pair<const float*, double>> m_frames;
          mutable std::shared_mutex mutex_;
      };
  
      // ------------------------------------------------------------
      // DopplerEffect : Calcul de la priorité de grille par décalage doppler symétrique
      // ------------------------------------------------------------
      class DopplerEffect {
      public:
          void setTarget(float tx, float ty, float vz) {
              if (tx < 0 || tx > 1.0f || ty < 0 || ty > 1.0f || vz < 0) {
                  targetX_ = 0.5f;
                  targetY_ = 0.3f;
                  velocityZ_ = 1.2f;
              } else {
                  targetX_ = tx;
                  targetY_ = ty;
                  velocityZ_ = vz;
              }
          }
  
          // Application de l'attraction gravitationnelle de Doppler sur les grilles de contrôle (sans toucher à la matrice brute)
          void applyToGrids(std::vector<GridPoint>& gridA, std::vector<GridPoint>& gridB, float asymmetryRatio) {
              // Équation de pression gravitationnelle cosmique d'équilibre (r_eq)
              // r_eq = sqrt((G * M * rho_eff) / F_cosmique)
              double F_cosmique = std::fabs(asymmetryRatio) * PI_CONST;
              if (F_cosmique < 1e-5) F_cosmique = 1e-5;
              double r_eq = std::sqrt((G_CONST * 1.0e11 * 1.2) / F_cosmique);
  
              for (size_t i = 0; i < gridA.size(); ++i) {
                  float dx = gridA[i].x - targetX_;
                  float dy = gridA[i].y - targetY_;
                  float distance = std::sqrt(dx * dx + dy * dy);
                  if (distance < 1e-5f) distance = 1e-5f;
  
                  // Décalage de Doppler influencé par la condition d'équilibre gravitationnel r_eq
                  float dopplerShift = static_cast<float>((gain_ / (1.0f + distance * 0.02f)) * (1.0f + velocityZ_) * (r_eq / PHI_GOLDEN));
                  
                  gridA[i].priority = dopplerShift;
                  
                  // Symétrie miroir sur la grille B
                  if (i < gridB.size()) {
                      gridB[i].priority = dopplerShift * static_cast<float>(PHI_GOLDEN / PI_CONST);
                  }
              }
          }
  
      private:
          float targetX_ = 0.5f;
          float targetY_ = 0.3f;
          float velocityZ_ = 1.2f;
          float gain_ = 2.0f;
          float falloff_ = 0.95f;
      };
  
      // ------------------------------------------------------------
      // AdaptiveThresholdValidator : Alignement des seuils adaptatifs
      // ------------------------------------------------------------
      class AdaptiveThresholdValidator {
      public:
          void setPriority(float p) {
              m_priority = p;
          }
  
          void validate(const std::vector<float>& cpuFrame, const std::vector<float>& gpuFrame, std::vector<GridPoint>& gridA, std::vector<GridPoint>& gridB, int width) {
              if (cpuFrame.size() < gridA.size() || gpuFrame.size() < gridB.size()) {
                  return;
              }
  
              for (size_t i = 0; i < gridA.size(); ++i) {
                  int idxA = gridA[i].y * width + gridA[i].x;
                  int idxB = gridB[i].y * width + gridB[i].x;
                  
                  if (idxA >= cpuFrame.size() || idxB >= gpuFrame.size()) continue;
  
                  float valA = cpuFrame[idxA];
                  float valB = gpuFrame[idxB];
                  
                  float diff = std::abs(valA - valB);
                  // Plus la priorité Doppler/temporelle est forte, plus le seuil est adaptatif
                  float threshold = 0.05f * m_priority * static_cast<float>(PI_CONST / PHI_GOLDEN);
                  
                  if (diff < threshold) {
                      gridA[i].validated = true;
                      gridB[i].validated = true;
                  } else {
                      gridA[i].validated = false;
                      gridB[i].validated = false;
                  }
              }
          }
  
      private:
          float m_priority = 1.0f;
      };
  
      // ------------------------------------------------------------
      // SignatureCache : Cache O(1) de signatures géométriques
      // ------------------------------------------------------------
      class SignatureCache {
      public:
          SignatureCache(int width) : width_(width) {}
  
          void precomputeSignatures(const std::vector<float>& frame, int bs) {
              if (frame.empty()) return;
              std::unique_lock<std::shared_mutex> lock(mutex_);
              
              cache_[bs].resize(bs * bs, 0);
              for (int y = 0; y < bs; ++y) {
                  for (int x = 0; x < bs; ++x) {
                      size_t idx = y * width_ + x;
                      if (idx < frame.size()) {
                          uint64_t sum = static_cast<uint64_t>(frame[idx] * 1000.0f);
                          cache_[bs][y * bs + x] = sum % 997;
                      }
                  }
              }
          }
  
          uint64_t computeSignature(const std::vector<float>& frame, int x, int y, int size) const {
              std::shared_lock<std::shared_mutex> lock(mutex_);
              auto it = cache_.find(size);
              if (it != cache_.end() && !it->second.empty()) {
                  size_t cacheIdx = (y % size) * size + (x % size);
                  return it->second[cacheIdx];
              }
              
              // Fallback de calcul linéaire géométrique
              double sum = 0.0;
              for (int dy = 0; dy < size; ++dy) {
                  for (int dx = 0; dx < size; ++dx) {
                      size_t idx = (y + dy) * width_ + (x + dx);
                      if (idx < frame.size()) {
                          sum += frame[idx];
                      }
                  }
              }
              return static_cast<uint64_t>(sum * 1000.0 * PI_CONST) % 997;
          }
  
      private:
          int width_;
          std::unordered_map<int, std::vector<uint64_t>> cache_;
          mutable std::shared_mutex mutex_;
      };
  
