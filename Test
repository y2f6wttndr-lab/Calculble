      // ------------------------------------------------------------
      // Bloc Mémoire : Structure de base d'un bloc de données
      // ------------------------------------------------------------
      struct MemoryBlock {
          std::vector<uint8_t> data;
          bool isUsed = false;
          uint32_t lastTickUsed = 0;
      };
  
      // ------------------------------------------------------------
      // MemoryPool : Pool de mémoire à taille fixe pré-allouée
      // ------------------------------------------------------------
      class MemoryPool {
      public: 
          explicit MemoryPool(size_t blockCount = 152, size_t blockSize = 4096)
              : blockCount_(blockCount)
              , blockSize_(blockSize) {
              pool_.resize(blockCount);
              for (auto& block : pool_) {
                  block.data.resize(blockSize, 0);
              }
          }
  
          // Alloue un bloc du pool en utilisant le ratio d'asymétrie pour ajuster la priorité d'allocation
          MemoryBlock* allocate(float asymmetryRatio, uint32_t currentTick) {
              std::unique_lock<std::shared_mutex> lock(mutex_);
              
              // Détermination de l'index de départ basé sur la précision de Pi et le ratio d'asymétrie
              double offsetFactor = std::fabs(asymmetryRatio) * PI_CONST;
              size_t startIndex = static_cast<size_t>(std::floor(offsetFactor)) % blockCount_;
  
              for (size_t i = 0; i < blockCount_; ++i) {
                  size_t targetIndex = (startIndex + i) % blockCount_;
                  if (!pool_[targetIndex].isUsed) {
                      pool_[targetIndex].isUsed = true;
                      pool_[targetIndex].lastTickUsed = currentTick;
                      return &pool_[targetIndex];
                  }
              }
              
              // Si tout est plein, on recycle le bloc le plus ancien
              size_t oldestIndex = 0;
              uint32_t oldestTick = 0xFFFFFFFFu;
              for (size_t i = 0; i < blockCount_; ++i) {
                  if (pool_[i].lastTickUsed < oldestTick) {
                      oldestTick = pool_[i].lastTickUsed;
                      oldestIndex = i;
                  }
              }
              
              pool_[oldestIndex].isUsed = true;
              pool_[oldestIndex].lastTickUsed = currentTick;
              return &pool_[oldestIndex];
          }
  
          void deallocate(MemoryBlock* block) {
              std::unique_lock<std::shared_mutex> lock(mutex_);
              if (block) {
                  block->isUsed = false;
              }
          }
  
          size_t blockCount() const { return blockCount_; }
          size_t blockSize() const { return blockSize_; }
  
      private:
          size_t blockCount_;
          size_t blockSize_;
          std::vector<MemoryBlock> pool_;
          mutable std::shared_mutex mutex_;
      };
  
      // ------------------------------------------------------------
      // MemoryAccessor : Accesseur sécurisé avec indexation par Pi
      // ------------------------------------------------------------
      class MemoryAccessor {
      public:
          explicit MemoryAccessor(std::shared_ptr<MemoryPool> pool)
              : pool_(std::move(pool)) {}
  
          // Lit ou écrit en appliquant l'indexation temporelle par rapport aux décimales de Pi
          void processTemporalRead(MemoryBlock* block, float asymmetryRatio) {
              if (!block) return;
              
              // Résolution de l'index par Pi pour cibler les données d'historique pertinentes
              double piIndex = std::fabs(asymmetryRatio) * PI_CONST;
              size_t targetOffset = static_cast<size_t>(std::floor(piIndex * 1000.0)) % pool_->blockSize();
              
              // Opération symbolique simulant le ciblage dans le bloc
              if (targetOffset < block->data.size()) {
                  block->data[targetOffset] = static_cast<uint8_t>(24); // Valeur de décharge physique par défaut
              }
          }
  
      private:
          std::shared_ptr<MemoryPool> pool_;
      };
  
