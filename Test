      template <typename T>
      class CircularBuffer {
      public:
          explicit CircularBuffer(std::size_t capacity = 152)
              : capacity_(capacity) {}
  
          void push(const T& value, float asymmetryRatio) {
              // Ajustement dynamique de la capacité pour amortir le stuttering
              std::size_t dynamicCapacity = capacity_;
              if (asymmetryRatio > 0.0f) {
                  dynamicCapacity = static_cast<std::size_t>(capacity_ * (1.0f + asymmetryRatio));
              }
              dynamicCapacity = std::clamp(dynamicCapacity, std::size_t(24), std::size_t(152));
  
              buffer_.push_back(value);
              if (buffer_.size() > dynamicCapacity) {
                  buffer_.erase(buffer_.begin());
              }
          }
  
          std::vector<T> discharge() {
              std::vector<T> temp;
              std::swap(temp, buffer_);
              return temp;
          }
  
          std::size_t size() const { return buffer_.size(); }
          bool empty() const { return buffer_.empty(); }
  
      private:
          std::size_t capacity_;
          std::vector<T> buffer_;
      };
  
      template <typename T>
      class SingleDoubleBuffer {
      public:
          SingleDoubleBuffer() : activeBuffer_(0), hasData_(false) {}
  
          void updateData(const T& data) {
              std::unique_lock<std::shared_mutex> lock(mutex_);
              const std::size_t nextBuffer = 1 - activeBuffer_;
              buffers_[nextBuffer] = data;
              activeBuffer_ = nextBuffer;
              hasData_ = true;
          }
  
          std::optional<T> readData() const {
              std::shared_lock<std::shared_mutex> lock(mutex_);
              if (!hasData_) return std::nullopt;
              return buffers_[activeBuffer_];
          }
  
      private:
          mutable std::shared_mutex mutex_;
          T buffers_[2];
          std::size_t activeBuffer_;
          bool hasData_;
      };
  
