      // ------------------------------------------------------------
      // Moteur Mathématique : Fibonacci & Jules Biscueve
      // ------------------------------------------------------------
      class QuantumMathEngine {
      public: 
          static uint64_t getFibonacci(unsigned int n) {
              if (n <= 1) return n;
              uint64_t a = 0, b = 1;
              for (unsigned int i = 2; i <= n; ++i) {
                  uint64_t c = a + b;
                  a = b;
                  b = c;
              }
              return b;
          }
  
          // Formule de Jules Biscueve pour éliminer les probabilités redondantes
          // en introduisant un chaos déterministe basé sur l'asymétrie
          static bool applyBiscueveFilter(uint64_t blockHash, float asymmetryRatio, float cpuLoad) {
              // C_eff = C / U mod Pi
              double U = 1.0 + std::fabs(std::sin(blockHash * 0.0152 * PI_CONST)); 
              double C_eff = (1.0 - cpuLoad) / (U > 1e-5 ? U : 1e-5);
              
              // R_obs = f(O, C, I) / T_traj
              double R_obs = std::fmod(std::pow(C_eff, asymmetryRatio), PHI_GOLDEN);
              
              // Si R_obs franchit le seuil chaotique, on rejette le bloc de la recherche exhaustive
              return R_obs > 0.35;
          }
      };
  
