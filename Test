      // Constante mathématique pour le jitter et le ratio d'asymétrie
      constexpr double PI_CONST = 3.14159265358979323846;
  
      // ------------------------------------------------------------
      // Structure des Métriques d'Intention
      // ------------------------------------------------------------
      struct IntentMetrics {
          float intensity = 0.0f;
          float coherence = 0.0f;
          float asymmetryRatio = 0.0f; // Ratio linéaire calculé (passé vs futur)
      };
  
      // ------------------------------------------------------------
      // IntentDetector avec calcul linéaire du ratio d'asymétrie (π)
      // ------------------------------------------------------------
      class IntentDetector {
      public:
          static IntentMetrics analyze(float prev, float curr, float next) {
              IntentMetrics m{};
              
              const float d1 = curr - prev; // Flux passé (N-1 -> N)
              const float d2 = next - curr; // Flux futur (N -> N+1)
              
              const float mag = std::fabs(d1) + std::fabs(d2);
              m.intensity = mag / (1.0f + mag);
              
              const float dot = d1 * d2;
              const float denom = (std::fabs(d1) + std::fabs(d2)) + 1e-6f;
              float dirScore = 0.0f;
              if (denom > 0.0f) {
                  dirScore = dot / (denom * denom);
              }
              m.coherence = 0.5f * (std::clamp(dirScore, -1.0f, 1.0f) + 1.0f);
  // Calcul du ratio d'asymétrie linéaire basé sur la constante PI
              // Régule la direction du flux temporel pour anticiper la décharge
              const float weightPrev = std::fabs(d1) * static_cast<float>(PI_CONST);
              const float weightNext = std::fabs(d2) * static_cast<float>(PI_CONST);
              const float totalWeight = weightPrev + weightNext + 1e-6f;
              
              m.asymmetryRatio = (weightNext - weightPrev) / totalWeight;
              
              return m;
          }
      };
  
