              if (!_memory || offset + size > _memory->size()) return false;
              _entries[id] = {offset, size};
              return true;
          }
  
          MemoryHelper::View getView(const std::string& id) {
              if (!_memory) return {};
              auto it = _entries.find(id);
              if (it == _entries.end()) return {};
              return _memory->view(it->second.offset, it->second.size);
          }
  
      private:
          MemoryHelper* _memory = nullptr;
          std::unordered_map<std::string, Entry> _entries;
      };
  
      class ChoreographySync {
      public:
          struct FrameContext {
              double timeSeconds = 0.0;
              uint64_t frameIndex = 0;
          };
  
          void beginFrame(const FrameContext& ctx) {
              _current = ctx;
          }
  
          const FrameContext& current() const { return _current; }
  
          template<typename TDoubleSingleBuffer>
          void endFrame(TDoubleSingleBuffer& buffer) {
              buffer.swap();
          }
  
      private:
          FrameContext _current{};
      };
  
