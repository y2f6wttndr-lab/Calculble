---
  // VRTulator.hpp
  #pragma once
  
  #include <chrono>
  #include <algorithm>
  #include <cstddef>
  
  namespace fp_scale {
  
      struct VRTConfig {
          double targetFrameTimeMs = 16.67; // Ciblage 60 FPS par défaut
          double safetyMargin      = 0.20;  // 20% de marge de sécurité pour le CPU
          std::size_t minIterations = 1;
          std::size_t maxIterations = 152;  // Limite haute calée sur l'horloge 152-cycle
      };
  
      class VRTulator {
      public: 
          explicit VRTulator(const VRTConfig& cfg = VRTConfig{})
              : cfg_(cfg)
              , currentIterations_(cfg.minIterations) {} 
  
          // Démarre la mesure de la phase CPU
          void beginFrame() {
              startTime_ = std::chrono::high_resolution_clock::now();
          }
  
          // Arrête la mesure, calcule la dérive et ajuste les itérations pour le prochain cycle
          std::size_t endFrame() {
              auto endTime = std::chrono::high_resolution_clock::now();
              std::chrono::duration<double, std::milli> elapsed = endTime - startTime_;
              const double actualMs = elapsed.count();
  
              // Seuil à ne pas dépasser pour rester dans la zone verte
              const double budgetMs = cfg_.targetFrameTimeMs * (1.0 - cfg_.safetyMargin);
  
              if (actualMs < budgetMs) {
                  // Le CPU a de la marge : on augmente progressivement la précision
                  const double ratio = budgetMs / (actualMs + 1e-6);
                  if (ratio > 1.1) {
                      currentIterations_ = std::min(cfg_.maxIterations, 
                          static_cast<std::size_t>(currentIterations_ * 1.1));
                  } else {
                      currentIterations_ = std::min(cfg_.maxIterations, currentIterations_ + 1);
                  }
              } else {
                  // Surchauffe ou saturation détectée : bridage agressif pour sécuriser la fluidité
                  currentIterations_ = std::max(cfg_.minIterations, 
                      static_cast<std::size_t>(currentIterations_ * 0.7));
              }
  
              return currentIterations_;
          }
  
          std::size_t currentIterations() const { return currentIterations_; }
  
      private:
          VRTConfig cfg_;
          std::size_t currentIterations_;
          std::chrono::high_resolution_clock::time_point startTime_;
      };
  
  } // namespace fp_scale
