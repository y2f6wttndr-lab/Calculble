Voici le bloc AdaptiveThresholdValidator complet et connecté à notre HybridBufferSystem. Il récupère directement les priorités modulées par le Doppler pour adapter le seuil de validation bloc par bloc en mode zéro copie.

---
  // AdaptiveThresholdValidator.hpp
  #pragma once
  
  #include <vector>
  #include <cmath>
  #include <memory>
  #include <algorithm>
  #include "HybridBufferSystem.hpp"
  
  namespace FPScale
  {
      struct Block {
          int x, y, size;
          bool validated = false;
          float priority = 1.0f; // Poids Doppler reçu du dispatch
      };
  
      struct DispatchState {
          std::vector<Block> gridA;
          std::vector<Block> gridB;
          bool isStable = true;
      };
  
      class AdaptiveThresholdValidator
      {
      public:
          AdaptiveThresholdValidator(int width, int height)
              : m_width(width)
              , m_height(height)
          {}
  
          // Validation adaptative basée sur le mouvement (priorité Doppler)
          // Consomme le DispatchState immuable du HybridBufferSystem
          void validate(
              const std::vector<float>& cpuFrame, 
              const std::vector<float>& gpuFrame,
              HybridBufferSystem<FrameData, DispatchState>& buffers)
          {
              if (cpuFrame.empty() || gpuFrame.empty()) return;
  
              // 1. On récupère l'état d'écriture pour appliquer nos validations
              auto& state = buffers.begin_dispatch_update();
  
              if (state.gridA.empty() || state.gridB.empty()) 
              {
                  buffers.end_dispatch_update();
                  return;
              }
  
              // 2. Validation bloc par bloc avec seuil asservi à la priorité
              for (size_t i = 0; i < state.gridA.size(); ++i)
              {
                  auto& blockA = state.gridA[i];
                  auto& blockB = state.gridB[i];
  
                  // Protection hors-limites indexation
                  int offsetA = blockA.y * m_width + blockA.x;
                  int offsetB = blockB.y * m_width + blockB.x;
  
                  if (offsetA >= static_cast<int>(cpuFrame.size()) || 
                      offsetB >= static_cast<int>(gpuFrame.size())) 
                  {
                      continue;
                  }
  
                  float valA = cpuFrame[offsetA];
                  float valB = gpuFrame[offsetB];
                  float diff = std::abs(valA - valB);
  
                  // Le seuil s'adapte selon la priorité Doppler du bloc.
                  // Plus la priorité (mouvement détecté) est élevée, plus on ajuste le niveau de tolérance.
                  float baseThreshold = 0.05f;
                  float threshold = baseThreshold * blockA.priority;
  
                  if (diff < threshold)
                  {
                      blockA.validated = true;
                      blockB.validated = true;
                  }
                  else
                  {
                      blockA.validated = false;
                      blockB.validated = false;
                  }
              }
  
              // 3. Commit atomique pour pousser les grilles validées vers le pipeline de rendu
              buffers.end_dispatch_update();
          }
  
      private:
          int m_width;
          int m_height;
      };
  } // namespace FPScale
