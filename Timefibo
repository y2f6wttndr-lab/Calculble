  // VRTulator.hpp
  #pragma once
  #include <chrono>
  #include <algorithm>
  #include <iostream>
  
  namespace FPScale {
      class VRTulator {
      public:
          VRTulator(double targetFrameTimeMs = 16.6) 
              : m_targetTime(targetFrameTimeMs)
              , m_optimalIterations(152) // Baseline de départ
              , m_isCalibrated(false)
              , m_cycleCount(0) {}
  
          // Ajuste dynamiquement la charge selon le temps de résolution réel
          uint32_t monitorAndTune(double lastFrameTimeMs) {
              m_cycleCount++;
  
              if (!m_isCalibrated && m_cycleCount <= 152) {
                  // Phase d'Auto-Train active sur le premier cycle
                  if (lastFrameTimeMs < m_targetTime * 0.8) {
                      m_optimalIterations = std::min(m_optimalIterations + 8, uint32_t(500));
                  } else if (lastFrameTimeMs > m_targetTime * 0.95) {
                      m_optimalIterations = std::max(m_optimalIterations - 16, uint32_t(16));
                  }
                  
                  if (m_cycleCount == 152) {
                      m_isCalibrated = true;
                      std::cout << "[Auto-Train Complete] Optimal Iterations set to: " << m_optimalIterations << std::endl;
                  }
              } else {
                  // Monitoring continu post-calibration (Watchdog)
                  if (lastFrameTimeMs > m_targetTime) {
                      m_optimalIterations = std::max(m_optimalIterations - 8, uint32_t(16)); // Sécurité anti-saturation
                  }
              }
  
              return m_optimalIterations;
          }
  
          bool isCalibrated() const noexcept { return m_isCalibrated; }
          uint32_t getOptimalIterations() const noexcept { return m_optimalIterations; }
  
      private:
          double m_targetTime;
          uint32_t m_optimalIterations;
          bool m_isCalibrated;
          uint64_t m_cycleCount;
      };
  }
