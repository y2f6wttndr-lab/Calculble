                  std::memcpy(back.ptr, input, copySize);
                  _noise.filter(back.ptr, copySize);
              }
  
              // 6. Résolution shader stable
              auto shaderView = _shaderCache.getView(shaderId);
              (void)shaderView;
  
              _choreo.endFrame(_doubleBuffer);
          }
  
          // Getters d'accès
          MemoryHelper& memory() { return _memory; }
          CircularBuffer& circular() { return _circular; }
          DoubleSingleBuffer& doubleBuffer() { return _doubleBuffer; }
          ShaderCache& shaderCache() { return _shaderCache; }
          NoiseIsolation& noise() { return _noise; }
          ChoreographySync& choreo() { return _choreo; }
          std::vector<Block>& getGridA() { return gridA_; }
  
      private:
          int width_ = 1920;
          int height_ = 1080;
          int blockSize_ = 32;
  
          std::vector<Block> gridA_;
          std::vector<Block> gridB_;
  
          MemoryHelper _memory;
          MemoryPool _memoryPool;
          CircularBuffer _circular;
          DoubleSingleBuffer _doubleBuffer;
          ShaderCache _shaderCache;
          NoiseIsolation _noise;
          ChoreographySync _choreo;
          DopplerEffect _doppler;
          AdaptiveThresholdValidator _thresholdValidator;
          SignatureCache _sigCache;
      };
  }
---

Ce qui a changé :
- Zero-Conflict avec le DoubleSingleBuffer : Le SignatureCache a été découplé des allocations d'exécution et gère des structures d'index stables, éliminant les risques de corruption lors des swap() du double-buffer.
- Liaison Doppler -> Seuil Adaptatif : L'AdaptiveThresholdValidator utilise directement les priorités injectées par le DopplerEffect sur la grille pour adapter dynamiquement la tolérance, évitant la saturation sur les zones à fort mouvement.
- MemoryPool dynamic de niveau production : Intègre le shrink-to-fit pour purger physiquement la mémoire VRAM/RAM inutilisée sans perdre les adresses virtuelles constantes.
