      public:
          CircularBuffer() = default;
  
          void bindMemory(MemoryHelper::View view) {
              _buffer = view.ptr;
              _capacity = view.size;
              _head.store(0, std::memory_order_relaxed);
              _tail.store(0, std::memory_order_relaxed);
          }
  
          bool push(const uint8_t* data, size_t size) {
              if (!_buffer || size > _capacity) return false;
  
              size_t head = _head.load(std::memory_order_relaxed);
              size_t tail = _tail.load(std::memory_order_acquire);
  
              size_t freeSpace = (tail + _capacity - head - 1) % _capacity;
              if (size > freeSpace) return false;
  
              size_t firstChunk = std::min(size, _capacity - head);
              std::memcpy(_buffer + head, data, firstChunk);
              if (size > firstChunk) {
                  std::memcpy(_buffer, data + firstChunk, size - firstChunk);
              }
  
              _head.store((head + size) % _capacity, std::memory_order_release);
              return true;
          }
  
          bool pop(uint8_t* out, size_t size) {
              if (!_buffer || size > _capacity) return false;
  
              size_t tail = _tail.load(std::memory_order_relaxed);
              size_t head = _head.load(std::memory_order_acquire);
  
              size_t used = (head + _capacity - tail) % _capacity;
              if (size > used) return false;
  
              size_t firstChunk = std::min(size, _capacity - tail);
              std::memcpy(out, _buffer + tail, firstChunk);
              if (size > firstChunk) {
                  std::memcpy(out + firstChunk, _buffer, size - firstChunk);
              }
  
              _tail.store((tail + size) % _capacity, std::memory_order_release);
              return true;
          }
  
      private:
          uint8_t* _buffer = nullptr;
          size_t _capacity = 0;
          std::atomic<size_t> _head{0};
          std::atomic<size_t> _tail{0};
      };
  
      class DoubleSingleBuffer {
      public:
          struct Slot {
              uint8_t* ptr = nullptr;
              size_t size = 0;
          };
  
          void bindSlots(const Slot& a, const Slot& b) {
              _slots[0] = a;
              _slots[1] = b;
              _front.store(0, std::memory_order_relaxed);
          }
  
          Slot back() const {
              int front = _front.load(std::memory_order_acquire);
              return _slots[1 - front];
          }
  
          Slot front() const {
              int front = _front.load(std::memory_order_acquire);
              return _slots[front];
          }
  
          void swap() {
              int front = _front.load(std::memory_order_relaxed);
              _front.store(1 - front, std::memory_order_release);
          }
  
      private:
          Slot _slots[2]{};
          std::atomic<int> _front{0};
      };
  
      // ============================================================================
      // 3. MOTION & CACHE OPTIMIZATIONS (SIGNATURE CACHE O(1) & ADAPTIVE THRESHOLD)
      // ============================================================================
      class SignatureCache {
      public:
          SignatureCache() = default;
          
          void precomputeSignatures(int bs, int width, const std::vector<float>& frame) {
              if (frame.empty()) return;
              _precomputedSignatures.resize(bs);
  
              for (int s = 1; s < bs; ++s) {
                  _precomputedSignatures[s].resize(frame.size(), 0);
                  for (int y = 0; y + s < height_; ++y) {
                      for (int x = 0; x + s < width; ++x) {
                          uint64_t sum = 0;
                          for (int dy = 0; dy < s; ++dy) {
                              for (int dx = 0; dx < s; ++dx) {
                                  sum += static_cast<uint64_t>(frame[(y + dy) * width + (x + dx)] * 1000.0f);
                              }
                          }
                          _precomputedSignatures[s][y * width + x] = sum % 997;
                      }
                  }
              }
          }
  
          uint64_t computeSignature(const std::vector<float>& frame, int x, int y, int size, int width) const {
              if (size < _precomputedSignatures.size() && y * width + x < _precomputedSignatures[size].size()) {
                  uint64_t cachedSig = _precomputedSignatures[size][y * width + x];
                  if (cachedSig != 0) return cachedSig;
              }
  
              // Fallback O(N) si hors cache
              float sum = 0.0f;
              for (int dy = 0; dy < size && (y + dy) * width < frame.size(); ++dy) {
                  for (int dx = 0; dx < size && (x + dx) < width; ++dx) {
                      sum += frame[(y + dy) * width + (x + dx)];
                  }
              }
              return static_cast<uint64_t>(sum * 1000.0f) % 997;
          }
  
      private:
          int height_ = 1080;
          std::vector<std::vector<uint64_t>> _precomputedSignatures;
      };
  
      class AdaptiveThresholdValidator {
      public:
          void setPriority(float p) { m_priority = p; }
  
          void validate(const std::vector<float>& cpuFrame, const std::vector<float>& gpuFrame, 
                        std::vector<Block>& gridA, std::vector<Block>& gridB, int width) {
              if (cpuFrame.empty() || gpuFrame.empty() || gridA.empty()) return;
  
              for (size_t i = 0; i < gridA.size(); ++i) {
                  int idxA = gridA[i].y * width + gridA[i].x;
                  int idxB = gridB[i].y * width + gridB[i].x;
                  
                  if (idxA >= cpuFrame.size() || idxB >= gpuFrame.size()) continue;
  
                  float valA = cpuFrame[idxA];
                  float valB = gpuFrame[idxB];
  
                  float diff = std::abs(valA - valB);
                  // Plus la priorité du bloc (Doppler) est haute, plus le seuil est permissif pour éviter les bottlenecks
                  float threshold = 0.05f * (1.0f + gridA[i].priority * m_priority);
  
                  bool isValid = (diff < threshold);
                  gridA[i].validated = isValid;
                  gridB[i].validated = isValid;
              }
          }
  
      private:
          float m_priority = 1.0f;
      };
  
      class DopplerEffect {
      public:
          void setTarget(float tx, float ty, float vz) {
              if (tx < 0 || tx > 1.0f || ty < 0 || ty > 1.0f || vz < 0) {
                  targetX_ = 0.5f; targetY_ = 0.3f; velocityZ_ = 1.2f;
              } else {
                  targetX_ = tx; targetY_ = ty; velocityZ_ = vz;
              }
          }
  
          void applyToGrids(std::vector<Block>& gridA, std::vector<Block>& gridB) {
              for (size_t i = 0; i < gridA.size(); ++i) {
                  float dx = gridA[i].x - targetX_;
                  float dy = gridA[i].y - targetY_;
                  float distance = std::sqrt(dx * dx + dy * dy);
  
                  float dopplerShift = gain_ / (1.0f + distance * 0.02f) * (1.0f + velocityZ_);
                  gridA[i].priority = dopplerShift;
                  gridB[i].priority = dopplerShift; 
              }
          }
  
      private:
          float targetX_ = 0.5f;
          float targetY_ = 0.3f;
          float velocityZ_ = 1.2f;
          float gain_ = 2.0f;
      };
  
      // ============================================================================
      // 4. PIPELINE AUXILIARY LAYERS (SHADERS, NOISE, CHOREOGRAPHY)
      // ============================================================================
      class NoiseIsolation {
      public:
          void filter(uint8_t* data, size_t size) {
              if (!data || size < 3) return;
              for (size_t i = 1; i + 1 < size; ++i) {
                  data[i] = static_cast<uint8_t>((data[i - 1] + data[i] + data[i + 1]) / 3);
              }
          }
      };
  
      class ShaderCache {
      public:
          struct Entry {
              size_t offset = 0;
              size_t size = 0;
          };
  
          void bindMemoryHelper(MemoryHelper* helper) {
              _memory = helper;
