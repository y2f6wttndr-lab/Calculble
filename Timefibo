  // MemoryHelper gère les accès mémoire bas niveau pour les buffers
  // Version 2.1 – compatible avec CircularBuffer, DoubleSingleBuffer et Shader Cache
  class MemoryHelper {
  public:
      struct View {
          uint8_t* ptr = nullptr;
          size_t   size = 0;
      };
  
      MemoryHelper() = default;
  
      // Alloue un bloc mémoire persistant pour les buffers
      void allocate(size_t size) {
          std::lock_guard<std::mutex> lock(_mutex);
          _storage.resize(size);
          _basePtr = _storage.data();
          _size    = _storage.size();
      }
  
      // Vue linéaire protégée (utilisée par le circular buffer)
      View view(size_t offset, size_t length) {
          std::lock_guard<std::mutex> lock(_mutex);
          if (offset + length > _size) {
              return {nullptr, 0};
          }
          return { _basePtr + offset, length };
      }
  
      uint8_t* data() { return _basePtr; }
      size_t   size() const { return _size; }
  
  private:
      std::vector<uint8_t> _storage;
      uint8_t*             _basePtr = nullptr;
      size_t               _size    = 0;
      std::mutex           _mutex;
  };
  
  // CircularBuffer.hpp
  #pragma once
  #include <cstddef>
  #include <cstdint>
  #include <atomic>
  
  // CircularBuffer utilise la mémoire fournie par MemoryHelper
  // Version 2.1 – offsets stables pour le Shader Cache
  class CircularBuffer {
  public:
      CircularBuffer() = default;
  
      void bindMemory(MemoryHelper::View view) {
          _buffer  = view.ptr;
          _capacity = view.size;
          _head.store(0, std::memory_order_relaxed);
          _tail.store(0, std::memory_order_relaxed);
      }
  
      // Ecriture non bloquante, wrap automatique
      bool push(const uint8_t* data, size_t size) {
          if (!_buffer || size > _capacity) return false;
  
          size_t head = _head.load(std::memory_order_relaxed);
          size_t tail = _tail.load(std::memory_order_acquire);
  
          size_t freeSpace = (tail + _capacity - head - 1) % _capacity;
          if (size > freeSpace) return false;
  
          size_t firstChunk = std::min(size, _capacity - head);
          std::memcpy(_buffer + head, data, firstChunk);
          if (size > firstChunk) {
              std::memcpy(_buffer, data + firstChunk, size - firstChunk);
          }
  
          _head.store((head + size) % _capacity, std::memory_order_release);
          return true;
      }
  
      // Lecture non bloquante
      bool pop(uint8_t* out, size_t size) {
          if (!_buffer || size > _capacity) return false;
  
          size_t tail = _tail.load(std::memory_order_relaxed);
          size_t head = _head.load(std::memory_order_acquire);
  
          size_t used = (head + _capacity - tail) % _capacity;
          if (size > used) return false;
  
          size_t firstChunk = std::min(size, _capacity - tail);
          std::memcpy(out, _buffer + tail, firstChunk);
          if (size > firstChunk) {
              std::memcpy(out + firstChunk, _buffer, size - firstChunk);
          }
  
          _tail.store((tail + size) % _capacity, std::memory_order_release);
          return true;
      }
  
  private:
      uint8_t*           _buffer   = nullptr;
      size_t             _capacity = 0;
      std::atomic<size_t> _head{0};
      std::atomic<size_t> _tail{0};
  };
  
  // DoubleSingleBuffer.hpp
  #pragma once
  #include <atomic>
  #include <cstdint>
  
  // DoubleSingleBuffer – un buffer double pour la stabilité frame par frame
  // Writer écrit dans le back, reader lit dans le front, swap atomique
  class DoubleSingleBuffer {
  public:
      struct Slot {
          uint8_t* ptr = nullptr;
          size_t   size = 0;
      };
  
      void bindSlots(const Slot& a, const Slot& b) {
          _slots[0] = a;
          _slots[1] = b;
          _front.store(0, std::memory_order_relaxed);
      }
  
      // Vue pour le writer
      Slot back() const {
          int front = _front.load(std::memory_order_acquire);
          return _slots[1 - front];
      }
  
      // Vue pour le reader
      Slot front() const {
          int front = _front.load(std::memory_order_acquire);
          return _slots[front];
      }
  
      // Appelé à la fin d’une frame chorégraphiée
      void swap() {
          int front = _front.load(std::memory_order_relaxed);
          _front.store(1 - front, std::memory_order_release);
      }
  
  private:
      Slot              _slots[2]{};
      std::atomic<int>  _front{0};
  };
  
