  // IntentDetector.hpp
  #pragma once
  #include <vector>
  #include <cmath>
  #include <numeric>
  
  namespace FPScale {
      struct IntentMetrics {
          float intensity = 0.0f;
          float coherence = 0.0f;
          bool dynamicBranchTrigger = false;
      };
  
      class IntentDetector {
      public:
          IntentDetector() : m_historyIndex(0) {
              m_motionHistory.resize(152, 0.0f); // Calé sur le cycle complet de 152
          }
  
          IntentMetrics analyze(const std::vector<float>& cpuFrame, const std::vector<float>& gpuFrame) {
              IntentMetrics metrics;
              if (cpuFrame.empty() || gpuFrame.empty()) return metrics;
  
              // Calcul rapide de la différence moyenne (flux de mouvement brut)
              float deltaSum = 0.0f;
              size_t step = 16; // Sous-échantillonnage pour garder un impact CPU dérisoire
              size_t count = 0;
              
              for (size_t i = 0; i < cpuFrame.size(); i += step) {
                  deltaSum += std::abs(cpuFrame[i] - gpuFrame[i]);
                  count++;
              }
              
              float currentDiff = (count > 0) ? (deltaSum / count) : 0.0f;
              m_motionHistory[m_historyIndex] = currentDiff;
              m_historyIndex = (m_historyIndex + 1) % 152;
  
              // Calcul de la cohérence globale sur l'historique
              float historySum = std::accumulate(m_motionHistory.begin(), m_motionHistory.end(), 0.0f);
              metrics.intensity = currentDiff;
              metrics.coherence = historySum / 152.0f;
  
              // Logique de branchement dynamique (Seuils 24 / 48)
              if (metrics.intensity > metrics.coherence * 1.5f) {
                  metrics.dynamicBranchTrigger = true;
              }
  
              return metrics;
          }
  
      private:
          std::vector<float> m_motionHistory;
          size_t m_historyIndex;
      };
  }
