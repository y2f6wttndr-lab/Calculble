      Slot back() const {
          int front = _front.load(std::memory_order_acquire);
          return _slots[1 - front];
      }
  
      // Vue pour le reader
      Slot front() const {
          int front = _front.load(std::memory_order_acquire);
          return _slots[front];
      }
  
