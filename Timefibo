// FPScaleCore.hpp
#pragma once

#include <cmath>
#include <cstddef>
#include <cstdint>

namespace fp_scale {

    // ----------------------------
    // Intent metrics & detector
    // ----------------------------

    struct IntentMetrics {
        float intensity;   // 0..1
        float coherence;   // 0..1
    };

    template <typename T>
    class IntentDetector {
    public:
        static IntentMetrics analyze(T prev, T curr, T next) {
            IntentMetrics m{};

            const float p = static_cast<float>(prev);
            const float c = static_cast<float>(curr);
            const float n = static_cast<float>(next);

            const float d1 = c - p;   // N-1 -> N
            const float d2 = n - c;   // N   -> N+1

            const float mag = std::fabs(d1) + std::fabs(d2);
            const float norm = 1.0f + mag;
            m.intensity = mag / norm; // soft-normalized 0..1

            const float dot   = d1 * d2;
            const float len1  = std::fabs(d1);
            const float len2  = std::fabs(d2);
            const float denom = (len1 + len2) + 1e-6f;

            float direction_score = 0.0f;
            if (denom > 0.0f) {
                direction_score = dot / (denom * denom);
            }

            if (direction_score >  1.0f) direction_score =  1.0f;
            if (direction_score < -1.0f) direction_score = -1.0f;

            m.coherence = 0.5f * (direction_score + 1.0f); // [-1,1] -> [0,1]

            return m;
        }

        static IntentMetrics analyzeSeries(const T* data, std::size_t count) {
            if (!data || count < 3) {
                return {0.0f, 0.0f};
            }

            const std::size_t mid = count / 2;
            const T prev = data[mid == 0 ? 0 : mid - 1];
            const T curr = data[mid];
            const T next = data[mid + 1 < count ? mid + 1 : count - 1];

            return analyze(prev, curr, next);
        }
    };

    // ----------------------------
    // NoiseSync: primary stabilizer
    // ----------------------------

    struct NoiseSyncConfig {
        float baseAmplitude   = 1.0f;   // amplitude of the white-noise-like carrier
        float smoothingFactor = 0.95f;  // 0..1, closer to 1 = smoother
        float bias            = 0.0f;   // bias applied to keep average flux flat
    };

    class NoiseSync {
    public:
        explicit NoiseSync(const NoiseSyncConfig& cfg = NoiseSyncConfig{})
            : cfg_(cfg)
            , state_(0.0f)
            , seed_(0x12345678u) {}

        void reset() {
            state_ = 0.0f;
            seed_  = 0x12345678u;
        }

        // Generate one stabilized noise sample for this tick.
        // This is the "white noise choreography" that keeps GPU flux constant.
        float nextSample() {
            const float raw = pseudoRandomUnit();
            const float target = cfg_.baseAmplitude * raw + cfg_.bias;
            state_ = cfg_.smoothingFactor  state_ + (1.0f - cfg_.smoothingFactor)  target;
            return state_;
        }

    private:
        float pseudoRandomUnit() {
            // simple LCG, deterministic, cheap
            seed_ = 1664525u * seed_ + 1013904223u;
            const uint32_t v = (seed_ >> 9) | 0x3F800000u; // 1.x float
            float f;
            std::memcpy(&f, &v, sizeof(f));
            return f - 1.0f; // [0,1)
        }

        NoiseSyncConfig cfg_;
        float           state_;
        uint32_t        seed_;
    };

    // ----------------------------
    // Core clockwork (152-cycle)
    // ----------------------------

    enum class TickPhase : uint8_t {
        Unknown  = 0,
        T8       = 1,
        T16a     = 2,
        T16b     = 3,
        T24      = 4,
        T48      = 5,
        Other    = 6
    };

    struct TickInfo {
        std::uint32_t cycleIndex;   // 0..151 in a cycle
        TickPhase     phase;        // logical phase (8,16,16,24,48,...)
        bool          isLatch24;    // true if this tick is candidate for flush at T=24
        bool          isLatch48;    // true if this tick is candidate for flush at T=48
    };

    class Clockwork152 {
    public:
        Clockwork152() : tick_(0) {}

        void reset() { tick_ = 0; }

        TickInfo next() {
            const std::uint32_t local = tick_ % 152u;
            TickInfo info{};
            info.cycleIndex = local;

            // Minimal mapping for the key phases.
            // You can refine this mapping to match your exact choreography.
            if (local == 7) {
                info.phase     = TickPhase::T8;
                info.isLatch24 = false;
                info.isLatch48 = false;
            } else if (local == 15) {
                info.phase     = TickPhase::T16a;
                info.isLatch24 = false;
                info.isLatch48 = false;
            } else if (local == 31) {
                info.phase     = TickPhase::T16b;
                info.isLatch24 = false;
                info.isLatch48 = false;
            } else if (local == 47) {
                info.phase     = TickPhase::T24;
                info.isLatch24 = true;
                info.isLatch48 = false;
            } else if (local == 95) {
                info.phase     = TickPhase::T48;
                info.isLatch24 = false;
                info.isLatch48 = true;
            } else {
                info.phase     = TickPhase::Other;
                info.isLatch24 = false;
                info.isLatch48 = false;
            }

            ++tick_;
            return info;
        }

        std::uint32_t globalTick() const { return tick_; }

    private:
        std::uint32_t tick_;
    };

    // ----------------------------
    // Frame buffer / half-mesh logic
    // ----------------------------

    struct BufferStats {
        std::size_t storedHalfMeshes   = 0;  // in buffer
        std::size_t releasedAt24       = 0;  // total released on 24-latches
        std::size_t releasedAt48       = 0;  // total released on 48-latches
        std::size_t virtualIterations  = 0;  // count of virtual iterations validated
    };

    struct BranchingConfig {
        float coherenceThreshold24 = 0.4f; // below -> flush early at 24
        float coherenceThreshold48 = 0.7f; // above -> prefer 48 burst
        std::size_t maxHalfMeshes  = 512;  // safety max before forced flush
    };

    class HalfMeshBuffer {
    public:
        explicit HalfMeshBuffer(const BranchingConfig& cfg = BranchingConfig{})
            : cfg_(cfg) {}

        void reset() {
            stats_ = BufferStats{};
        }

        void pushVirtual(std::size_t count) {
            stats_.storedHalfMeshes  += count;
            stats_.virtualIterations += count;
        }

        // Decision at T=24: either flush now or keep accumulating.
        // Returns number of half-meshes to flush at this tick.
        std::size_t onLatch24(const IntentMetrics& intent) {
            if (shouldForceFlush()) {
                return flushAll24();
            }

            if (intent.coherence < cfg_.coherenceThreshold24) {
                return flushAll24();
            }

            // High enough coherence -> keep for 48
            return 0;
        }

        // Decision at T=48: either release a big block or stay conservative.
        std::size_t onLatch48(const IntentMetrics& intent) {
            if (stats_.storedHalfMeshes == 0) {
                return 0;
            }

            if (shouldForceFlush() || intent.coherence >= cfg_.coherenceThreshold48) {
                return flushAll48();
            }

            // Coherence not convincing at 48 -> small conservative flush.
            const std::size_t toRelease = stats_.storedHalfMeshes / 4u; // 25%
            stats_.storedHalfMeshes -= toRelease;
            stats_.releasedAt48     += toRelease;
            return toRelease;
        }

        const BufferStats& stats() const { return stats_; }

    private:
        bool shouldForceFlush() const {
            return stats_.storedHalfMeshes >= cfg_.maxHalfMeshes;
        }

        std::size_t flushAll24() {
            const std::size_t n = stats_.storedHalfMeshes;
            stats_.storedHalfMeshes = 0;
            stats_.releasedAt24    += n;
            return n;
        }

        std::size_t flushAll48() {
            const std::size_t n = stats_.storedHalfMeshes;
            stats_.storedHalfMeshes = 0;
            stats_.releasedAt48    += n;
            return n;
        }

        BranchingConfig cfg_;
        BufferStats     stats_{};
    };

    // ----------------------------
    // FPScale Core Engine
    // ----------------------------

    struct FPScaleConfig {
        NoiseSyncConfig noise;
        BranchingConfig branching;

        // Scaling factor from a tick to "virtual iterations".
        // Example: 1 = 1 half-mesh per tick, can be tuned per GPU/CPU profile.
        std::size_t iterationsPerTick = 1;
    };

    struct FPScaleState {
        std::uint64_t totalTicks       = 0;
        std::uint64_t gpuFluxSamples   = 0;
        float         lastNoiseSample  = 0.0f;
        IntentMetrics lastIntent       {0.0f, 0.0f};
        BufferStats   buffer;  // live buffer stats
    };

    template <typename IntentSampleT>
    class FPScaleCore {
    public:
        explicit FPScaleCore(const FPScaleConfig& cfg = FPScaleConfig{})
            : cfg_(cfg)
            , noise_(cfg.noise)
            , buffer_(cfg.branching) {}

        void reset() {
            clock_.reset();
            noise_.reset();
            buffer_.reset();
            state_ = FPScaleState{};
        }

        // Feed N-1 / N / N+1 samples from your pipeline (intensity, motion, etc.).
        // This drives IntentDetector and ultimately the T=24/T=48 branching.
        void tick(IntentSampleT prev, IntentSampleT curr, IntentSampleT next) {
            const TickInfo tinfo = clock_.next();

            const float carrier = noise_.nextSample();
            state_.lastNoiseSample = carrier;
            ++state_.gpuFluxSamples;

            const IntentMetrics im = IntentDetector<IntentSampleT>::analyze(prev, curr, next);
            state_.lastIntent = im;

            buffer_.pushVirtual(cfg_.iterationsPerTick);

            if (tinfo.isLatch24) {
                const std::size_t flushed = buffer_.onLatch24(im);
                (void)flushed; // in practice, route this to GPU as 24-path frames
            } else if (tinfo.isLatch48) {
                const std::size_t flushed = buffer_.onLatch48(im);
                (void)flushed; // in practice, route this to GPU as 48-path frames
            }

            state_.buffer    = buffer_.stats();
            ++state_.totalTicks;
        }

        const FPScaleState& state() const { return state_; }

    private:
        FPScaleConfig   cfg_;
        Clockwork152    clock_;
        NoiseSync       noise_;
        HalfMeshBuffer  buffer_;
        FPScaleState    state_{};
    };

} // namespace fp_scale

