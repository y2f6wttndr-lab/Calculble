---
  #pragma once
  
  #include <vector>
  #include <atomic>
  #include <cstddef>
  #include <cstdint>
  #include <mutex>
  #include <shared_mutex>
  #include <optional>
  
  // FPScale::HybridBufferSystem
  // - CircularBuffer<T>: 
  //     Fenêtre glissante lock-free-ish (single writer / multi reader) pour l’IntentDetector.
  //     Sert de "radar" sur le flux de frames (frame flux).
  // - SingleDoubleBuffer<T>:
  //     Double buffer immuable pour dispatcher vers Motion Vectors / Doppler.
  //     Zéro copie: on échange des index / pointeurs, jamais les données.
  //
  // Hypothèses principales:
  // - Le CPU écrit (pré-calcul) dans CircularBuffer et SingleDoubleBuffer.
  // - Le GPU (ou les tâches liées) lisent uniquement, jamais d’écriture côté consumer.
  // - On favorise les transitions zéro copie: les consommateurs reçoivent des vues constantes.
  
  namespace FPScale
  {
      using FrameIndex = std::uint64_t;
  
      // ============================================================
      //  CircularBuffer
      //  - Spécialement pensé pour l’IntentDetector (radar)
      //  - Single-Producer / Multi-Consumer
      // ============================================================
  
      template<typename T>
      class CircularBuffer
      {
      public:
          explicit CircularBuffer(std::size_t capacity)
              : m_capacity(capacity)
              , m_buffer(capacity)
              , m_writeIndex(0)
              , m_readIndex(0)
              , m_frameCounter(0)
          {}
  
          std::size_t capacity() const noexcept { return m_capacity; }
  
          // Push non bloquant
          // Retourne false si aucun slot libre (buffer plein)
          bool try_push(const T& value)
          {
              const auto currentWrite = m_writeIndex.load(std::memory_order_relaxed);
              const auto nextWrite   = increment(currentWrite);
  
              if (nextWrite == m_readIndex.load(std::memory_order_acquire))
              {
                  // Buffer plein
                  return false;
              }
  
              m_buffer[currentWrite] = value; // copie locale dans le slot
              m_frameCounter.fetch_add(1, std::memory_order_relaxed);
  
              m_writeIndex.store(nextWrite, std::memory_order_release);
              return true;
          }
  
          // Essaye de lire un élément en FIFO
          // Retourne std::nullopt si buffer vide
          std::optional<T> try_pop()
          {
              const auto currentRead = m_readIndex.load(std::memory_order_relaxed);
              if (currentRead == m_writeIndex.load(std::memory_order_acquire))
              {
                  // Vide
                  return std::nullopt;
              }
  
              T value = m_buffer[currentRead];
              const auto nextRead = increment(currentRead);
  
              m_readIndex.store(nextRead, std::memory_order_release);
              return value;
          }
  
          // Accès non destructif à une fenêtre glissante pour l’IntentDetector
          // L’IntentDetector peut scanner un snapshot logique du buffer
          // sans bloquer l’écriture (lecture par copie, mais zéro copie de transition de buffer).
          template<typename Fn>
          void for_each_snapshot(Fn&& fn) const
          {
              // Snapshot des indices
              const auto read  = m_readIndex.load(std::memory_order_acquire);
              const auto write = m_writeIndex.load(std::memory_order_acquire);
  
              if (read == write)
                  return; // rien à lire
  
              std::size_t idx = read;
              while (idx != write)
              {
                  fn(m_buffer[idx]);
                  idx = increment(idx);
              }
          }
  
          FrameIndex frame_count() const noexcept
          {
              return m_frameCounter.load(std::memory_order_relaxed);
          }
  
      private:
          std::size_t increment(std::size_t idx) const noexcept
          {
              ++idx;
              if (idx >= m_capacity) idx = 0;
              return idx;
          }
  
          const std::size_t             m_capacity;
          std::vector<T>                m_buffer;
          std::atomic<std::size_t>      m_writeIndex;   // producteur
          std::atomic<std::size_t>      m_readIndex;    // consommateur FIFO
          std::atomic<FrameIndex>       m_frameCounter; // pour l’IntentDetector (radar)
      };
  
  
      // ============================================================
      //  SingleDoubleBuffer
      //  - Un seul producteur (CPU pré-calcul)
      //  - N consommateurs (GPU / Motion Vectors / Doppler)
      //  - Le producteur écrit dans un buffer "back"
      //  - Commit = flip atomique des rôles (front/back)
      //  - Les consommateurs lisent un snapshot immuable (front) sans lock lourd
      // ============================================================
  
      template<typename T>
      class SingleDoubleBuffer
      {
      public:
          SingleDoubleBuffer()
              : m_frontIndex(0)
          {
              // Les deux buffers sont par défaut value-initialized
          }
  
          // Accès CPU (pré-calcul): buffer d’écriture mutable
          T& write_buffer()
          {
              const std::size_t backIndex = 1u - m_frontIndex.load(std::memory_order_relaxed);
              return m_buffers[backIndex];
          }
  
          // Commit des données préparées vers les consommateurs
          // Zéro copie: on ne déplace pas les données, on switch juste l’index
          void commit()
          {
              // Empêche les reordonnancements d’écriture avant le flip
              m_frontIndex.store(1u - m_frontIndex.load(std::memory_order_relaxed),
                                 std::memory_order_release);
          }
  
          // Accès lecture pour GPU / Motion Vectors / Doppler
          // Retourne une référence constante vers le buffer courant (front)
          const T& read_buffer() const
          {
              const std::size_t front = m_frontIndex.load(std::memory_order_acquire);
              return m_buffers[front];
          }
  
          // Version thread-safe avec verrou partagé si T n’est pas trivially copyable
          // et que tu veux éviter tout data race interne.
          const T& read_buffer_locked() const
          {
              std::shared_lock lock(m_mutex);
              const std::size_t front = m_frontIndex.load(std::memory_order_acquire);
              return m_buffers[front];
          }
  
          // Commit avec verrou si tu veux sérialiser certaines opérations complexes
          void commit_locked()
          {
              std::unique_lock lock(m_mutex);
              m_frontIndex.store(1u - m_frontIndex.load(std::memory_order_relaxed),
                                 std::memory_order_release);
          }
  
      private:
          T                               m_buffers[2];
          std::atomic<std::size_t>        m_frontIndex; // 0 ou 1
          mutable std::shared_mutex       m_mutex;
      };
  
  
      // ============================================================
      //  HybridBufferSystem
      //  - Glue logique entre:
      //      * CircularBuffer<FrameType> pour IntentDetector
      //      * SingleDoubleBuffer<DispatchState> pour Motion Vectors / Doppler
      // ============================================================
  
      template<typename FrameType, typename DispatchState>
      class HybridBufferSystem
      {
      public:
          explicit HybridBufferSystem(std::size_t circularCapacity)
              : m_circular(circularCapacity)
          {}
  
          // --- CPU PRE-CALC STAGE ---------------------------------
  
          // Le CPU pousse les frames brutes dans le radar
          bool push_frame(const FrameType& frame)
          {
              return m_circular.try_push(frame);
          }
  
          // L’IntentDetector analyse la fenêtre glissante
          template<typename IntentDetectorFn>
          void analyze_intent(IntentDetectorFn&& detector)
          {
              m_circular.for_each_snapshot(std::forward<IntentDetectorFn>(detector));
          }
  
          // Le CPU prépare un état de dispatch pour Motion Vectors / Doppler
          // Exemple: résultats d’analyse, flags, matrices, etc.
          DispatchState& begin_dispatch_update()
          {
              return m_dispatch.write_buffer();
          }
  
          // Commit atomique: l’état devient visible côté GPU / Motion Vectors / Doppler
          void end_dispatch_update()
          {
              m_dispatch.commit();
          }
  
          // --- GPU / TASK STAGE -----------------------------------
  
          // Vue immuable sur l’état de dispatch pour les Motion Vectors
          const DispatchState& current_dispatch_state() const
          {
              return m_dispatch.read_buffer();
          }
  
          // Si tu veux séparer explicitement les rôles:
          const DispatchState& for_motion_vectors() const
          {
              return m_dispatch.read_buffer();
          }
  
          const DispatchState& for_doppler() const
          {
              return m_dispatch.read_buffer();
          }
  
          FrameIndex frame_count() const noexcept
          {
              return m_circular.frame_count();
          }
  
      private:
          CircularBuffer<FrameType>     m_circular;  // Radar pour IntentDetector
          SingleDoubleBuffer<DispatchState> m_dispatch; // Centre de tri vers Motion Vectors / Doppler
      };
  
  } // namespace FPScale
  
