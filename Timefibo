---
  // FPSBoosterPipeline.hpp
  #pragma once
  
  #include <vector>
  #include <memory>
  #include <algorithm>
  #include <cmath>
  
  #include "HybridBufferSystem.hpp"
  #include "DopplerMotionAware.hpp"
  #include "TemporalConsistency.hpp"
  #include "AdaptiveThresholdValidator.hpp"
  
  namespace FPScale
  {
      class FPSBoosterPipeline
      {
      public:
          FPSBoosterPipeline(int width, int height, int blockSize)
              : m_width(width)
              , m_height(height)
              , m_blockSize(blockSize)
              , m_globalFrameCount(0)
              , m_currentPassIndex(0)
          {
              setupGrids();
              
              // Initialisation de la config par défaut
              m_dopplerConfig.dopplerIntensity = 1.2f;
              m_dopplerConfig.smoothingFactor = 0.15f;
              
              m_temporalConfig.smoothingFactor = 0.25f;
              m_temporalConfig.historyDepth = 4;
              m_temporalConfig.passBoundaryBoost = 0.5f;
              
              m_dopplerModule = std::make_unique<DopplerMotionAware>(m_dopplerConfig);
              m_temporalModule = std::make_unique<TemporalConsistency>(m_temporalConfig);
              m_validator = std::make_unique<AdaptiveThresholdValidator>(m_width, m_height);
          }
  
          // Point d'entrée principal non-linéaire calé sur le métronome
          void processFrame(const std::vector<float>& cpuFrame, 
                            const std::vector<float>& gpuFrame,
                            std::vector<float>& outputFrame)
          {
              if (cpuFrame.empty() || gpuFrame.empty()) return;
              outputFrame.resize(cpuFrame.size(), 0.0f);
  
              // 1. Détermination de la longueur de la passe selon la chorégraphie (8, 16, 24, 48...)
              uint32_t currentPassLength = determinePassLength(m_currentPassIndex);
  
              // 2. Mise à jour de l'état système dans le HybridBufferSystem
              updateSystemStates(currentPassLength);
  
              // 3. Passage Doppler : Modulation des priorités basée sur le mouvement détecté
              // Consomme l'état du HybridBuffer pour modifier les poids de Grid A & B
              m_dopplerModule->apply(m_buffers);
  
              // 4. Validation adaptative : Seuil asservi à la priorité Doppler par bloc
              m_validator->validate(cpuFrame, gpuFrame, m_buffers);
  
              // 5. Interpolation et lissage via l'historique temporel (Temporal Consistency)
              m_temporalModule->apply(m_buffers);
  
              // 6. Synthèse finale asynchrone et reconstruction du frame de sortie
              synthesizeOutput(cpuFrame, gpuFrame, outputFrame);
  
              // 7. Tick de l'orchestrateur : Incrémentation et rotation des phases
              advanceOrchestration(currentPassLength);
          }
  
      private: 
          int m_width;
          int m_height;
          int m_blockSize;
          
          uint64_t m_globalFrameCount;
          uint32_t m_currentPassIndex;
  
          std::vector<Block> m_gridA;
          std::vector<Block> m_gridB;
  
          // Modules
          std::unique_ptr<DopplerMotionAware> m_dopplerModule;
          std::unique_ptr<TemporalConsistency> m_temporalModule;
          std::unique_ptr<AdaptiveThresholdValidator> m_validator;
  
          // Configs
          DopplerMotionAware::Config m_dopplerConfig;
          TemporalConsistency::Config m_temporalConfig;
  
          // Système de buffers partagé
          HybridBufferSystem<FrameSample, DispatchState> m_buffers;
  
          uint32_t determinePassLength(uint32_t passIndex) const noexcept
          {
              // Suite de la chorégraphie de passes : 8, 16, 24, 48, etc.
              // Exemple simple de cycle : 8 -> 16 -> 24 -> 48
              uint32_t step = passIndex % 4;
              switch (step)
              {
                  case 0: return 8;
                  case 1: return 16;
                  case 2: return 24;
                  case 3: return 48;
                  default: return 16;
              }
          }
  
          void updateSystemStates(uint32_t passLength) noexcept
          {
              // Préparation des états de dispatch
              auto& dispatch = m_buffers.begin_dispatch_update();
              dispatch.gridA = m_gridA;
              dispatch.gridB = m_gridB;
              dispatch.isStable = true;
              m_buffers.end_dispatch_update();
  
              // Préparation de l'état temporel pour la cohérence
              TemporalState tempState;
              tempState.globalFrameCounter = m_globalFrameCount;
              tempState.passIndex = m_currentPassIndex;
              tempState.passLength = passLength;
              
              // Rotation logique du SingleDoubleBuffer (0 = A, 1 = B)
              tempState.doubleBufferReadSide = static_cast<uint8_t>(m_globalFrameCount % 2);
              
              m_buffers.setTemporalStatePointer(&tempState);
          }
  
          void synthesizeOutput(const std::vector<float>& cpuFrame, 
                                 const std::vector<float>& gpuFrame,
                                 std::vector<float>& outputFrame) noexcept
          {
              const auto& dispatch = m_buffers.get_dispatch_view();
              
              for (int y = 0; y < m_height; ++y)
              {
                  for (int x = 0; x < m_width; ++x)
                  {
                      int idx = y * m_width + x;
                      if (idx >= static_cast<int>(outputFrame.size())) continue;
  
                      // Récupération de l'état de validation de la grille active
                      bool isValidated = false;
                      if (!dispatch.gridA.empty() && !dispatch.gridB.empty())
                      {
                          // On mappe le pixel au bloc correspondant
                          int blockX = x / m_blockSize;
                          int blockY = y / m_blockSize;
                          int cols = m_width / m_blockSize;
                          size_t blockIdx = blockY * cols + blockX;
  
                          if (blockIdx < dispatch.gridA.size())
                          {
                              isValidated = dispatch.gridA[blockIdx].validated || 
                                            dispatch.gridB[blockIdx].validated;
                          }
                      }
  
                      if (isValidated)
                      {
                          // Flush direct de la frame GPU pour éliminer toute latence de bus
                          outputFrame[idx] = gpuFrame[idx];
                      }
                      else
                      {
                          // Interpolation douce 50/50 avec la source pour stabiliser
                          outputFrame[idx] = (cpuFrame[idx] + gpuFrame[idx]) * 0.5f;
                      }
                  }
              }
          }
  
          void advanceOrchestration(uint32_t currentPassLength) noexcept
          {
              m_globalFrameCount++;
              m_currentPassIndex++;
              
              // Reset de l'index de phase à la fin de la chorégraphie globale
              if (m_currentPassIndex >= 152) 
              {
                  m_currentPassIndex = 0;
              }
          }
  
          void setupGrids() 
          {
              if (m_width <= 0 || m_height <= 0 || m_blockSize <= 1) return;
  
              int cols = m_width / m_blockSize;
              int rows = m_height / m_blockSize;
  
              m_gridA.clear();
              m_gridB.clear();
  
              for (int y = 0; y < rows; ++y) 
              {
                  for (int x = 0; x < cols; ++x) 
                  {
                      Block a{ x * m_blockSize, y * m_blockSize, m_blockSize };
                      // Effet miroir symétrique sur l'axe X
                      Block b{ (cols - 1 - x) * m_blockSize, y * m_blockSize, m_blockSize };
  
                      m_gridA.push_back(a);
                      m_gridB.push_back(b);
                  }
              }
          }
      };
  }
