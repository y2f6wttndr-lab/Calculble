      TemporalStateView _temporalView;
  };
  
  // -----------------------------------------------------------------------------
  // CircularBufferView : vue logique sur l'historique pour l'interpolation
  // -----------------------------------------------------------------------------
  
  class CircularBufferView
  {
  public:
      CircularBufferView() = default;
  
      CircularBufferView(const FrameBuffer* buffer,
                         uint64_t head,
                         uint32_t size) noexcept
          : _buffer(buffer)
          , _head(head)
          , _size(size)
      {}
  
      bool isValid() const noexcept
      {
          return _buffer != nullptr && !_buffer->empty() && _size > 0;
      }
  
      // Accès logique à une frame relative (0 = plus récente)
      const FrameSample* atRelative(uint32_t offset) const noexcept
      {
          if (!isValid() || offset >= _size)
              return nullptr;
  
          const uint64_t idx = (_head + _buffer->size() - offset) % _buffer->size();
          return &(*_buffer)[static_cast<size_t>(idx)];
      }
  
  private:
      const FrameBuffer* _buffer { nullptr };
      uint64_t _head { 0 };
      uint32_t _size { 0 };
  };
  
  // -----------------------------------------------------------------------------
  // TemporalConsistency : interpolation + lissage synchronisés sur la chorégraphie
  // -----------------------------------------------------------------------------
  
  class TemporalConsistency
  {
  public:
      struct Config
      {
          // Facteur global de lissage [0,1]
          float smoothingFactor = 0.25f;
  
          // Nombre maximum de frames regardées en arrière pour l'interpolation
          uint32_t historyDepth = 4; // par ex. on regarde jusqu'à 4 frames derrière
  
          // Force d'alignement sur les bords de passe
          // Exemple: à la fin d'une passe, on force un peu plus le snap
          float passBoundaryBoost = 0.5f;
      };
  
      explicit TemporalConsistency(const Config& cfg = Config{})
          : _cfg(cfg)
      {}
  
      // Point d'entrée principal :
      // consomme uniquement la vue temporelle immuable fournie par HybridBufferSystem
      void apply(const HybridBufferSystem& buffers) noexcept
      {
          TemporalStateView view = buffers.getTemporalStateView();
          if (!view.isValid())
              return;
  
          const TemporalState& state = *view;
          if (!state.readBuffer || !state.writeBuffer)
              return;
  
          if (state.readBuffer->empty() || state.writeBuffer->empty())
              return;
  
          const FrameBuffer& src = *state.readBuffer;
          FrameBuffer&       dst = *state.writeBuffer;
  
          // Sanity check
          const size_t count = std::min(src.size(), dst.size());
          if (count == 0)
              return;
  
          // Vue circulaire pour récupérer l'historique
          CircularBufferView historyView{ &src, state.circularHead, state.circularSize };
  
          const bool historyOK = historyView.isValid();
  
          // Position relative dans la passe courante
          const uint32_t passLen   = std::max(1u, state.passLength);
          const uint32_t passIndex = state.passIndex % passLen;
  
          // Phase normalisée dans la passe [0,1]
          const float phase = static_cast<float>(passIndex) / static_cast<float>(passLen - 1u);
  
          // Facteur de smoothing de base
          float baseAlpha = std::clamp(_cfg.smoothingFactor, 0.0f, 1.0f);
  
          // Renforcement du smoothing en fin de passe pour éviter les ruptures
          // Exemple: quand on approche de la fin de la passe, on augmente alpha
          if (passLen > 1u)
          {
              const float boundaryWeight = std::pow(phase, 2.0f); // plus fort en fin de passe
              baseAlpha = std::clamp(baseAlpha + _cfg.passBoundaryBoost * boundaryWeight,
                                     0.0f, 1.0f);
          }
  
          // On peut aussi adapter légèrement selon le côté de lecture du double buffer
          // pour respecter la chorégraphie du flip :
          const bool readSideIsA = (state.doubleBufferReadSide == 0);
          const float sideBias   = readSideIsA ? 0.0f : 0.05f;
          const float alpha      = std::clamp(baseAlpha + sideBias, 0.0f, 1.0f);
  
          for (size_t i = 0; i < count; ++i)
          {
              const FrameSample& srcSample = src[i];
              FrameSample&       dstSample = dst[i];
  
              // Valeur brute de la frame actuelle
              const float current = srcSample.value;
  
              // Estimation de la valeur "cible" basée sur l'historique
              float target = current;
  
              if (historyOK && _cfg.historyDepth > 0)
              {
                  // simple moyenne pondérée des dernières frames
                  float accum = 0.0f;
                  float weightSum = 0.0f;
  
                  const uint32_t depth = std::min(_cfg.historyDepth, state.circularSize);
                  for (uint32_t h = 0; h < depth; ++h)
                  {
                      const FrameSample* past = historyView.atRelative(h);
                      if (!past)
                          break;
  
                      // Poids décroissant avec l'ancienneté
                      const float w = 1.0f / static_cast<float>(h + 1u);
                      accum += past->value * w;
                      weightSum += w;
                  }
  
                  if (weightSum > 0.0f)
                      target = accum / weightSum;
              }
  
              // Interpolation lissée entre l'ancienne valeur smoothed et la cible
              const float previousSmoothed = dstSample.smoothed;
              const float blended = previousSmoothed + alpha * (target - previousSmoothed);
  
              dstSample.value    = current;          // on conserve la valeur brute
              dstSample.smoothed = blended;          // on met à jour la valeur lissée
              dstSample.frameId  = state.globalFrameCounter;
          }
      }
  
  private:
      Config _cfg;
  };
  
