Voici le bloc Core Engine complet et structuré en header-only. Il intègre directement tes grids en miroir (A et B), l'effet LEGO via le cache de signatures, et se synchronise parfaitement avec le HybridBufferSystem pour un pipeline immuable et zéro copie.

---
  #pragma once
  
  #include <vector>
  #include <unordered_map>
  #include <cmath>
  #include <memory>
  #include "HybridBufferSystem.hpp"
  
  namespace FPScale
  {
      struct Block {
          int x, y, size;
          bool validated = false;
      };
  
      // Structure contenant les données d'une frame à analyser par l'IntentDetector
      struct FrameData {
          std::vector<float> pixels;
          double timestamp;
      };
  
      // Structure d'état pour le dispatch (Motion Vectors / Doppler)
      struct DispatchState {
          std::vector<Block> gridA;
          std::vector<Block> gridB;
          bool isStable = true;
      };
  
      class VirtualUpscalePipeline
      {
      public:
          VirtualUpscalePipeline(int w, int h, int bs)
              : m_width(w)
              , m_height(h)
              , m_blockSize(bs)
              , m_bufferSystem(152) // Capacité calée sur l'horloge 152-cycle pour le radar
          {
              setupGrids();
          }
  
          void setupGrids()
          { 
              if (m_width <= 0 || m_height <= 0 || m_blockSize <= 1) return;
  
              int cols = m_width / m_blockSize;
              int rows = m_height / m_blockSize;
  
              m_initialGridA.clear();
              m_initialGridB.clear();
  
              for (int y = 0; y < rows; ++y)
              {
                  for (int x = 0; x < cols; ++x)
                  {
                      Block a{ x * m_blockSize, y * m_blockSize, m_blockSize };
                      Block b{ (cols - 1 - x) * m_blockSize, y * m_blockSize, m_blockSize };
  
                      m_initialGridA.push_back(a);
                      m_initialGridB.push_back(b);
                  }
              }
          }
  
          // Soumission d'une nouvelle frame au "radar" (CircularBuffer)
          void submitFrame(const std::vector<float>& pixels, double timestamp)
          {
              m_bufferSystem.push_frame(FrameData{ pixels, timestamp });
          }
  
          // Traitement principal liant le pré-calcul CPU et le dispatch atomique
          void processFrame(const std::vector<float>& cpuFrame, const std::vector<float>& gpuFrame)
          {
              // 1. Récupération de l'état d'écriture du SingleDoubleBuffer (zéro copie)
              auto& state = m_bufferSystem.begin_dispatch_update();
              state.gridA = m_initialGridA;
              state.gridB = m_initialGridB;
  
              // 2. Traitement avec effet LEGO (Signature caching)
              for (size_t i = 0; i < state.gridA.size(); ++i)
              {
                  uint64_t sigA = computeSignature(cpuFrame, state.gridA[i].x, state.gridA[i].y, state.gridA[i].size);
  
                  // LEGO EFFECT: Validation instantanée si déjà en cache
                  if (m_signatureCache.count(sigA))
                  {
                      state.gridA[i].validated = true;
                      state.gridB[i].validated = true;
                      continue; // Early exit pour ce bloc
                  }
  
                  // Seuil adaptatif basé sur la différence brute
                  float diff = std::abs(cpuFrame[state.gridA[i].y * m_width + state.gridA[i].x] - 
                                        gpuFrame[state.gridB[i].y * m_width + state.gridB[i].x]);
  
                  if (diff < 0.05f)
                  {
                      m_signatureCache[sigA] = true;
                      state.gridA[i].validated = true;
                      state.gridB[i].validated = true;
                  }
                  else
                  {
                      state.gridA[i].validated = false;
                      state.gridB[i].validated = false;
                  }
              }
  
              // 3. Commit atomique pour rendre les résultats visibles par le GPU/Doppler
              m_bufferSystem.end_dispatch_update();
          }
  
          // Accès en lecture seule pour le GPU ou les modules consommateurs
          const DispatchState& getDispatchState() const
          {
              return m_bufferSystem.current_dispatch_state();
          }
  
      private:
          uint64_t computeSignature(const std::vector<float>& frame, int x, int y, int size) const
          { 
              float sum = 0.0f;
              for (int dy = 0; dy < size; ++dy)
              {
                  for (int dx = 0; dx < size; ++dx)
                  {
                      int idx = (y + dy) * m_width + (x + dx);
                      if (idx >= 0 && idx < static_cast<int>(frame.size()))
                      {
                          sum += frame[idx];
                      }
                  }
              }
              return static_cast<uint64_t>(sum * 1000) % 997;
          }
  
          int m_width;
          int m_height;
          int m_blockSize;
          
          std::vector<Block> m_initialGridA;
          std::vector<Block> m_initialGridB;
          
          std::unordered_map<uint64_t, bool> m_signatureCache;
          
          // Système de buffers hybride gérant la synchronisation
          HybridBufferSystem<FrameData, DispatchState> m_bufferSystem;
      };
  } // namespace FPScale
