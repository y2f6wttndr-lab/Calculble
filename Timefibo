  // DopplerMotionAware.hpp
  #pragma once
  
  #include <vector>
  #include <cstdint>
  #include <cmath>
  #include <algorithm>
  
  // ------------------------------------------------------------
  // Interfaces de base déjà existantes dans ton engine
  // ------------------------------------------------------------
  
  struct GridCell
  {
      float baseValue;      // Intensité/énergie/poids de base
      float dopplerShift;   // Décalage calculé (sortie Doppler)
  };
  
  using Grid = std::vector<GridCell>;
  
  // Etat global dispatché par le Core Engine via HybridBufferSystem
  struct DispatchState
  {
      // Exemple de données pertinentes pour le Doppler
      float listenerVelocity;          // Vitesse du récepteur
      float sourceVelocity;            // Vitesse moyenne des sources
      float propagationSpeed;          // Vitesse de propagation dans le milieu
  
      // Facteur global de priorisation (par ex. pour scheduler)
      float priorityScale;
  
      // Grilles cibles (vue logique, non copiée dans le module)
      const Grid* primaryGrid;         // Peut être null si non utilisée
      const Grid* secondaryGrid;       // Optionnel
  };
  
  // Vue constante fournie par le HybridBufferSystem
  class DispatchStateView
  {
  public:
      DispatchStateView() = default;
  
      DispatchStateView(const DispatchState* state) noexcept
          : _state(state)
      {}
  
      const DispatchState* operator->() const noexcept { return _state; }
      const DispatchState& operator*() const noexcept  { return *_state; }
  
      bool isValid() const noexcept { return _state != nullptr; }
  
  private:
      const DispatchState* _state { nullptr }; // Pointeur constant, aucune propriété
  };
  
  // Interface minimale du HybridBufferSystem pour la lecture
  class HybridBufferSystem
  {
  public:
      // Retourne une vue immuable sur le DispatchState courant
      DispatchStateView getDispatchStateView() const noexcept
      {
          // Impl fournie par ton Core Engine / SingleDoubleBuffer
          return _currentView;
      }
  
      void setDispatchStatePointer(const DispatchState* state) noexcept
      {
          _currentView = DispatchStateView(state);
      }
  
  private:
      DispatchStateView _currentView;
  };
  
  // ------------------------------------------------------------
  // Module Doppler Motion Aware
  // ------------------------------------------------------------
  
  class DopplerMotionAware
  {
  public:
      struct Config
      {
          // Facteur de mix global du Doppler sur la valeur de base
          float dopplerIntensity = 1.0f;
  
          // Clamp pour éviter les explosions numériques
          float minShift = -4.0f;  // -4 octaves
          float maxShift =  4.0f;  // +4 octaves
  
          // Coefficient de lissage pour éviter les sauts brutaux
          float smoothingFactor = 0.1f; // [0,1]
      };
  
      explicit DopplerMotionAware(const Config& cfg = Config{})
          : _cfg(cfg)
      {}
  
      // Point d’entrée principal.
      // Ne prend AUCUNE donnée brute en paramètre.
      // Le module consomme uniquement la vue constante du DispatchState
      // fournie par le HybridBufferSystem.
      void apply(HybridBufferSystem const& buffers) noexcept
      {
          DispatchStateView view = buffers.getDispatchStateView();
          if (!view.isValid())
              return;
  
          const DispatchState& state = *view;
  
          // Sécurité sur la vitesse de propagation
          if (state.propagationSpeed <= 0.0001f)
              return;
  
          // Grille principale
          if (state.primaryGrid)
          {
              applyToGrid(*state.primaryGrid, state);
          }
  
          // Grille secondaire optionnelle
          if (state.secondaryGrid)
          {
              applyToGrid(*state.secondaryGrid, state);
          }
      }
  
  private:
      Config _cfg;
  
      void applyToGrid(const Grid& grid, const DispatchState& state) noexcept
      {
          // On ne modifie PAS la structure de la grille
          // On ne fait que calculer et écrire dopplerShift sur chaque cellule.
          // Si tu veux en faire un pur lecteur, tu peux stocker les sorties
          // ailleurs, mais ici on suppose que modifier dopplerShift est autorisé.
  
          const float relVelocity = state.sourceVelocity - state.listenerVelocity;
          const float v = state.propagationSpeed;
  
          if (std::abs(v) < 0.0001f)
              return;
  
          // Coefficient Doppler global (simplifié)
          const float baseFactor = v / (v - relVelocity);
  
          // On scale par la priorité globale pour intégrer le scheduler
          const float priorityScale = std::max(0.0f, state.priorityScale);
  
          const float targetShift = std::log2(std::max(0.0001f, baseFactor)) * _cfg.dopplerIntensity * priorityScale;
  
          const float clampedShift = std::clamp(targetShift, _cfg.minShift, _cfg.maxShift);
  
          // Lissage simple vers la nouvelle valeur globale
          const float alpha = std::clamp(_cfg.smoothingFactor, 0.0f, 1.0f);
  
          for (auto& cell : const_cast<Grid&>(grid))
          {
              const float current = cell.dopplerShift;
              const float blended = current + alpha * (clampedShift - current);
              cell.dopplerShift = blended;
          }
      }
  };
  
