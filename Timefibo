  }
  
  int main(int argc, char* argv[]) {
      const int WIDTH = 1920;
      const int HEIGHT = 1080;
      const int BLOCK_SIZE = 32;
      
      std::cout << "FPScale Ultimate Launcher v2.1" << std::endl;
      std::cout << "==================================" << std::endl;
      std::cout << "Resolution : " << WIDTH << "x" << HEIGHT << std::endl;
      std::cout << "Block Size : " << BLOCK_SIZE << "x" << BLOCK_SIZE << std::endl;
  
      // Initialisation du pipeline, de l'Intent Detector et du Watchdog d'Auto-Train
      FPScale::FPSBoosterPipeline pipeline(WIDTH, HEIGHT, BLOCK_SIZE);
      FPScale::IntentDetector intentDetector;
      FPScale::VRTulator vrtulator(16.66); // Cible de 60 FPS (16.66ms)
  
      const int MAX_FRAMES = 300;
      std::atomic<int> frameCount{0};
      float phaseShift = 0.0f;
  
      std::vector<float> cpuFrame(WIDTH * HEIGHT);
      std::vector<float> gpuFrame(WIDTH * HEIGHT);
      std::vector<float> outputFrame(WIDTH * HEIGHT, 0.0f);
  
      while (frameCount.load() < MAX_FRAMES) {
          auto startTick = std::chrono::high_resolution_clock::now();
  
          // 1. Capture/Simulation asynchrone des trames CPU et GPU
          phaseShift += 0.05f;
          for (int i = 0; i < WIDTH * HEIGHT; ++i) {
              int x = i % WIDTH;
              int y = i / WIDTH;
              cpuFrame[i] = readSimulatedPixel(x, y, phaseShift);
              gpuFrame[i] = readSimulatedPixel(x, y, phaseShift + 0.1f); // Léger offset temporel
          }
  
          // 2. Intent Detection en amont de la chorégraphie
          auto metrics = intentDetector.analyze(cpuFrame, gpuFrame);
  
          // 3. Traitement non-linéaire du pipeline asynchrone
          pipeline.processFrame(cpuFrame, gpuFrame, outputFrame);
  
          auto endTick = std::chrono::high_resolution_clock::now();
          std::chrono::duration<double, std::milli> elapsed = endTick - startTick;
          double frameTimeMs = elapsed.count();
  
          // 4. Monitoring et Auto-Calibration via le VRTulator
          uint32_t activeIterations = vrtulator.monitorAndTune(frameTimeMs);
  
          // Log périodique du statut d'adaptation
          if (frameCount.load() % 50 == 0) {
              std::cout << "[Frame " << frameCount.load() << "] Time: " << frameTimeMs 
